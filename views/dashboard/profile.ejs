                </div>
              </div>

            </div>
          </div>
        </div>

        <!-- Loading Overlay -->
        <div class="loading-overlay" id="loadingOverlay">
          <div class="loading-content">
            <div class="loading-spinner"></div>
            <p id="loadingText">Processing...</p>
          </div>
        </div>

        <!-- Deposit Modal -->
        <div class="modal fade" id="depositModal" tabindex="-1">
          <div class="modal-dialog">
            <div class="modal-content">
              <div class="modal-header">
                <h5 class="modal-title">Add Money</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
              </div>
              <div class="modal-body">
                <form id="depositForm">
                  <div class="mb-3">
                    <label for="depositAmount" class="form-label">Amount</label>
                    <div class="input-group">
                      <span class="input-group-text">$</span>
                      <input type="number" class="form-control" id="depositAmount" 
                             placeholder="0.00" min="1" max="100000" step="0.01" required>
                    </div>
                  </div>
                  <div class="mb-3">
                    <label for="depositDescription" class="form-label">Note (Optional)</label>
                    <input type="text" class="form-control" id="depositDescription" 
                           placeholder="e.g., Monthly deposit">
                  </div>
                </form>
              </div>
              <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="processDeposit()">Add Money</button>
              </div>
            </div>
          </div>
        </div>

        <!-- Withdraw Modal -->
        <div class="modal fade" id="withdrawModal" tabindex="-1">
          <div class="modal-dialog">
            <div class="modal-content">
              <div class="modal-header">
                <h5 class="modal-title">Withdraw Money</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
              </div>
              <div class="modal-body">
                <div class="alert alert-info">
                  Available: <strong id="withdrawAvailableBalance">$0.00</strong>
                </div>
                <form id="withdrawForm">
                  <div class="mb-3">
                    <label for="withdrawAmount" class="form-label">Amount</label>
                    <div class="input-group">
                      <span class="input-group-text">$</span>
                      <input type="number" class="form-control" id="withdrawAmount" 
                             placeholder="0.00" min="1" step="0.01" required>
                    </div>
                  </div>
                  <div class="mb-3">
                    <label for="withdrawDescription" class="form-label">Note (Optional)</label>
                    <input type="text" class="form-control" id="withdrawDescription" 
                           placeholder="e.g., Emergency withdrawal">
                  </div>
                </form>
              </div>
              <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="processWithdraw()">Withdraw</button>
              </div>
            </div>
          </div>
        </div>

        <!-- footer starts -->
        <%- include('partials/footer') %>
        <!-- footer ends -->
      </div>
    </div>

    <!--   Core JS Files   -->
    <script src="/dashboard/js/core/jquery-3.7.1.min.js"></script>
    <script src="/dashboard/js/core/popper.min.js"></script>
    <script src="/dashboard/js/core/bootstrap.min.js"></script>
    <script src="/dashboard/js/plugin/jquery-scrollbar/jquery.scrollbar.min.js"></script>
    <script src="/dashboard/js/plugin/bootstrap-notify/bootstrap-notify.min.js"></script>
    <script src="/dashboard/js/kaiadmin.min.js"></script>

   
  

<!-- User Data - Safe JSON approach -->
<!-- User Data - Safe JSON approach -->
<script type="application/json" id="user-data">
  <%- JSON.stringify(typeof user !== 'undefined' && user ? {
    firstName: user.firstName,
    lastName: user.lastName,  
    email: user.email,
    id: user.id
  } : null) %>
</script>

<script>
  let originalData = {};
  let userProfile = {};
  let sessionUser = null;

  try {
    const userDataElement = document.getElementById('user-data');
    sessionUser = userDataElement ? JSON.parse(userDataElement.textContent) : null;
    window.sessionUser = sessionUser;
  } catch (error) {
    sessionUser = null;
    window.sessionUser = null;
  }

  $(document).ready(function() {
    if (sessionUser) {
      initializeWithSessionData();
    }
    
    loadUserProfile();
    loadWalletData();
    loadRecentTransactions();
    setupAvatarUpload();
  });

  function initializeWithSessionData() {
    if (sessionUser) {
      $('#userName').text(sessionUser.firstName + ' ' + sessionUser.lastName);
      $('#userEmail').text(sessionUser.email);
      $('#firstName').val(sessionUser.firstName);
      $('#lastName').val(sessionUser.lastName);
      $('#email').val(sessionUser.email);
    }
  }

  async function loadUserProfile() {
    try {
      const response = await fetch('/api/user/profile', {
        credentials: 'include'
      });
      
      if (!response.ok) {
        if (response.status === 401) {
          showNotification('Please log in again', 'error');
          setTimeout(() => window.location.href = '/login', 2000);
          return;
        }
        throw new Error('Failed to load profile');
      }
      
      const data = await response.json();
      userProfile = data.user;
      updateProfileDisplay();
      
    } catch (error) {
      showNotification('Unable to load profile data', 'error');
    }
  }

  function updateProfileDisplay() {
    if (!userProfile) return;

    $('#userName').text(userProfile.firstName + ' ' + userProfile.lastName);
    $('#userEmail').text(userProfile.email);
    
    if (userProfile.createdAt) {
      $('#memberSince').text(new Date(userProfile.createdAt).toLocaleDateString('en-US', {
        year: 'numeric', month: 'short'
      }));
    }

    if (userProfile.isPremium) {
      $('#premiumBadge').removeClass('free-badge').addClass('premium-badge').text('Premium');
      $('#subscriptionInfo').addClass('premium');
      $('#subscriptionInfo .sub-title').text('Premium Plan');
      $('#subscriptionInfo .sub-details').text('Full access to all features and funds');
      
      if (userProfile.premiumExpiry) {
        const expiryDate = new Date(userProfile.premiumExpiry).toLocaleDateString('en-US', {
          year: 'numeric', month: 'long', day: 'numeric'
        });
        $('#subscriptionInfo .sub-details').text('Premium access until ' + expiryDate);
      }
    } else {
      $('#premiumBadge').removeClass('premium-badge').addClass('free-badge').text('Free');
      $('#subscriptionInfo').removeClass('premium');
      $('#subscriptionInfo .sub-title').text('Free Plan');
      $('#subscriptionInfo .sub-details').text('Basic access to investment features');
    }

    if (userProfile.profilePhoto) {
      $('#profileAvatar').html('<img src="' + userProfile.profilePhoto + '" alt="Profile" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;">');
    } else {
      const initials = (userProfile.firstName.charAt(0) + userProfile.lastName.charAt(0)).toUpperCase();
      $('#profileAvatar').html('<span>' + initials + '</span>');
    }

    $('#firstName').val(userProfile.firstName);
    $('#lastName').val(userProfile.lastName);
    $('#email').val(userProfile.email);
    
    originalData = {
      firstName: userProfile.firstName,
      lastName: userProfile.lastName,
      email: userProfile.email
    };
  }

  async function loadWalletData() {
    try {
      const response = await fetch('/api/wallet/portfolio', {
        credentials: 'include'
      });
      
      if (!response.ok) {
        throw new Error('Failed to load wallet data');
      }
      
      const data = await response.json();
      
      if (data && data.portfolio) {
        const portfolio = data.portfolio;
        const cashBalance = parseFloat(portfolio.cashBalance || 0);
        const investmentValue = parseFloat(portfolio.totalInvestmentValue || 0);
        const totalValue = parseFloat(portfolio.totalPortfolioValue || 0);
        
        $('#cashBalance').text('$' + cashBalance.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2}));
        $('#investmentValue').text('$' + investmentValue.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2}));
        $('#totalPortfolio').text('$' + totalValue.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2}));
        $('#withdrawAvailableBalance').text('$' + cashBalance.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2}));
      }
      
    } catch (error) {
      showNotification('Unable to load wallet data', 'error');
      $('#cashBalance').text('$0.00');
      $('#investmentValue').text('$0.00');
      $('#totalPortfolio').text('$0.00');
    }
  }

  async function loadRecentTransactions() {
    try {
      const response = await fetch('/api/wallet/transactions?limit=5', {
        credentials: 'include'
      });
      
      if (!response.ok) {
        throw new Error('Failed to load transactions');
      }
      
      const data = await response.json();
      const transactions = data.transactions || [];
      renderRecentTransactions(transactions);
      
    } catch (error) {
      $('#recentTransactions').html('<p style="text-align: center; color: #666; padding: 1rem;">Unable to load transactions</p>');
    }
  }

  function renderRecentTransactions(transactions) {
    if (!transactions || transactions.length === 0) {
      $('#recentTransactions').html('<p style="text-align: center; color: #666; padding: 1rem;">No recent transactions</p>');
      return;
    }

    const transactionsHtml = transactions.map(transaction => {
      const isPositive = ['DEPOSIT', 'SELL'].includes(transaction.type);
      const amountClass = isPositive ? 'amount-positive' : 'amount-negative';
      const amountPrefix = isPositive ? '+' : '-';
      
      return '<div class="transaction-item">' +
        '<div>' +
          '<div class="transaction-desc">' + (transaction.description || 'Transaction') + '</div>' +
          '<div class="transaction-date">' + formatDate(transaction.date) + '</div>' +
        '</div>' +
        '<div class="transaction-amount ' + amountClass + '">' +
          amountPrefix + '$' + parseFloat(transaction.amount || 0).toFixed(2) +
        '</div>' +
      '</div>';
    }).join('');

    $('#recentTransactions').html(transactionsHtml);
  }

  function setupAvatarUpload() {
    $('#avatarInput').on('change', function(e) {
      const file = e.target.files[0];
      if (file) {
        if (file.size > 5 * 1024 * 1024) { 
          showNotification('File size must be less than 5MB', 'error');
          return;
        }
        
        if (!file.type.startsWith('image/')) {
          showNotification('Please select a valid image file', 'error');
          return;
        }
        
        uploadAvatar(file);
      }
    });
  }

  async function uploadAvatar(file) {
    const formData = new FormData();
    formData.append('avatar', file);

    showLoading('Uploading avatar...');

    try {
      const response = await fetch('/api/user/upload-avatar', {
        method: 'POST',
        body: formData,
        credentials: 'include'
      });

      if (!response.ok) {
        throw new Error('Failed to upload avatar');
      }
      
      const data = await response.json();
      $('#profileAvatar').html('<img src="' + data.avatarUrl + '" alt="Profile" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;">');
      showNotification('Avatar updated successfully!', 'success');
      
    } catch (error) {
      showNotification('Failed to upload avatar', 'error');
    } finally {
      hideLoading();
    }
  }

  function toggleEditMode(section) {
    if (section === 'personal') {
      const isEditing = !$('#firstName').prop('disabled');
      
      if (isEditing) {
        $('#firstName, #lastName').prop('disabled', true);
        $('#personalActions').addClass('hidden');
        $('.edit-btn').html('<i class="fas fa-edit"></i> Edit');
        $('#firstName').val(originalData.firstName);
        $('#lastName').val(originalData.lastName);
      } else {
        $('#firstName, #lastName').prop('disabled', false);
        $('#personalActions').removeClass('hidden');
        $('.edit-btn').html('<i class="fas fa-times"></i> Cancel');
      }
    }
  }

  function cancelEdit(section) {
    if (section === 'personal') {
      toggleEditMode('personal');
    }
  }

  async function savePersonalInfo() {
    const firstName = $('#firstName').val().trim();
    const lastName = $('#lastName').val().trim();

    if (!firstName || !lastName) {
      showNotification('Please fill in all required fields', 'error');
      return;
    }

    showLoading('Saving changes...');

    try {
      const response = await fetch('/api/user/update-profile', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({ firstName, lastName })
      });

      if (!response.ok) {
        throw new Error('Failed to update profile');
      }
      
      userProfile.firstName = firstName;
      userProfile.lastName = lastName;
      originalData.firstName = firstName;
      originalData.lastName = lastName;
      
      if (sessionUser) {
        sessionUser.firstName = firstName;
        sessionUser.lastName = lastName;
      }
      
      $('#userName').text(firstName + ' ' + lastName);
      
      if (!userProfile.profilePhoto) {
        const initials = (firstName.charAt(0) + lastName.charAt(0)).toUpperCase();
        $('#profileAvatar').html('<span>' + initials + '</span>');
      }
      
      toggleEditMode('personal');
      showNotification('Profile updated successfully!', 'success');
      
    } catch (error) {
      showNotification('Failed to update profile', 'error');
    } finally {
      hideLoading();
    }
  }

  function openDepositModal() {
    $('#depositModal').modal('show');
  }

  function openWithdrawModal() {
    const currentBalance = parseFloat($('#cashBalance').text().replace('$', '').replace(/,/g, ''));
    if (currentBalance <= 0) {
      showNotification('No funds available to withdraw', 'warning');
      return;
    }
    $('#withdrawAmount').attr('max', currentBalance);
    $('#withdrawModal').modal('show');
  }

  async function processDeposit() {
    const amount = parseFloat($('#depositAmount').val());
    const description = $('#depositDescription').val() || 'Cash deposit';

    if (!amount || amount < 1 || amount > 100000) {
      showNotification('Please enter a valid amount between $1 and $100,000', 'error');
      return;
    }

    $('#depositModal').modal('hide');
    showLoading('Processing deposit...');

    try {
      const response = await fetch('/api/wallet/deposit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({ amount, description })
      });

      if (!response.ok) {
        throw new Error('Failed to process deposit');
      }
      
      $('#depositForm')[0].reset();
      showNotification('Deposit successful!', 'success');
      loadWalletData();
      loadRecentTransactions();
      
    } catch (error) {
      showNotification('Failed to process deposit', 'error');
    } finally {
      hideLoading();
    }
  }

  async function processWithdraw() {
    const amount = parseFloat($('#withdrawAmount').val());
    const description = $('#withdrawDescription').val() || 'Cash withdrawal';

    if (!amount || amount < 1) {
      showNotification('Please enter a valid amount', 'error');
      return;
    }

    const currentBalance = parseFloat($('#cashBalance').text().replace('$', '').replace(/,/g, ''));
    if (amount > currentBalance) {
      showNotification('Insufficient funds', 'error');
      return;
    }

    $('#withdrawModal').modal('hide');
    showLoading('Processing withdrawal...');

    try {
      const response = await fetch('/api/wallet/withdraw', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({ amount, description })
      });

      if (!response.ok) {
        throw new Error('Failed to process withdrawal');
      }
      
      $('#withdrawForm')[0].reset();
      showNotification('Withdrawal successful!', 'success');
      loadWalletData();
      loadRecentTransactions();
      
    } catch (error) {
      showNotification('Failed to process withdrawal', 'error');
    } finally {
      hideLoading();
    }
  }

  async function downloadTransactionHistory() {
    showLoading('Preparing download...');

    try {
      const response = await fetch('/api/user/export-transactions', {
        credentials: 'include'
      });
      
      if (!response.ok) {
        throw new Error('Failed to export transactions');
      }

      const blob = await response.blob();
      
      if (blob.size === 0) {
        throw new Error('No transaction data available');
      }
      
      const url = window.URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'transaction-history-' + new Date().toISOString().split('T')[0] + '.csv';
      
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      window.URL.revokeObjectURL(url);
      
      setTimeout(() => {
        showNotification('Transaction history downloaded successfully!', 'success');
      }, 500);
      
    } catch (error) {
      showNotification('Failed to export: ' + error.message, 'error');
    } finally {
      setTimeout(() => {
        hideLoading();
      }, 800);
    }
  }

  function showLoading(message) {
    if (!message) message = 'Processing...';
    $('#loadingText').text(message);
    $('#loadingOverlay').css('display', 'flex');
  }

  function hideLoading() {
    $('#loadingOverlay').hide();
  }

  function formatDate(dateString) {
    if (!dateString) return 'N/A';
    
    try {
      const date = new Date(dateString);
      return date.toLocaleDateString('en-US', { 
        month: 'short', 
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit'
      });
    } catch (error) {
      return 'Invalid Date';
    }
  }

  function showNotification(message, type) {
    if (!type) type = 'info';
    $.notify({
      message: message
    }, {
      type: type,
      placement: { from: 'top', align: 'right' },
      delay: 3000,
      animate: {
        enter: 'animated fadeInDown',
        exit: 'animated fadeOutUp'
      }
    });
  }
</script>

  </body>
</html>