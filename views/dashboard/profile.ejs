<!DOCTYPE html>
<html lang="en">
  <head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>Profile - CDT Index</title>
    <meta
      content="width=device-width, initial-scale=1.0, shrink-to-fit=no"
      name="viewport"
    />
    <link
      rel="icon"
      href="/dashboard/img/kaiadmin/favicon.ico"
      type="image/x-icon"
    />

    <!-- Fonts and icons -->
    <script src="/dashboard/js/plugin/webfont/webfont.min.js"></script>
    <script>
      WebFont.load({
        google: { families: ["Public Sans:300,400,500,600,700"] },
        custom: {
          families: [
            "Font Awesome 5 Solid",
            "Font Awesome 5 Regular",
            "Font Awesome 5 Brands",
            "simple-line-icons",
          ],
          urls: ["/dashboard/css/fonts.min.css"],
        },
        active: function () {
          sessionStorage.fonts = true;
        },
      });
    </script>

    <!-- CSS Files -->
    <link rel="stylesheet" href="/dashboard/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/dashboard/css/plugins.min.css" />
    <link rel="stylesheet" href="/dashboard/css/kaiadmin.min.css" />

    <style>
      body {
        background: #ffffff;
        color: #333;
        font-family: 'Public Sans', sans-serif;
      }
      
      .profile-container {
        max-width: 800px;
        margin: 0 auto;
        padding: 2rem 1rem;
      }
      
      .profile-header {
        background: #1a1a2e;
        border: 1px solid #e5e5e5;
        border-radius: 8px;
        padding: 2rem;
        margin-bottom: 2rem;
        color: white;
      }

      .profile-info {
        display: flex;
        align-items: center;
        gap: 1.5rem;
      }

      .avatar-container {
        position: relative;
        flex-shrink: 0;
      }

      .profile-avatar {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        border: 2px solid #6c5ce7;
        background: #6c5ce7;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        color: white;
        cursor: pointer;
        object-fit: cover;
      }

      .avatar-upload {
        position: absolute;
        bottom: 0;
        right: 0;
        background: #6c5ce7;
        border-radius: 50%;
        width: 24px;
        height: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: white;
        font-size: 0.7rem;
        border: 2px solid white;
      }

      .user-details h2 {
        margin: 0 0 0.25rem 0;
        font-size: 1.5rem;
        font-weight: 600;
      }

      .user-email {
        color: #ddd;
        font-size: 0.95rem;
        margin-bottom: 0.5rem;
      }

      .user-meta {
        display: flex;
        gap: 1rem;
        font-size: 0.85rem;
      }

      .meta-item {
        color: #ccc;
      }

      .premium-badge {
        background: #6c5ce7;
        color: white;
        padding: 0.15rem 0.5rem;
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: 500;
      }

      .free-badge {
        background: #666;
        color: white;
        padding: 0.15rem 0.5rem;
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: 500;
      }

      .section-card {
        background: white;
        border: 1px solid #e5e5e5;
        border-radius: 8px;
        margin-bottom: 1.5rem;
        overflow: hidden;
      }

      .section-header {
        padding: 1.25rem;
        border-bottom: 1px solid #e5e5e5;
        background: #fafafa;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .section-title {
        font-size: 1rem;
        font-weight: 600;
        color: #333;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .section-icon {
        color: #6c5ce7;
        font-size: 1rem;
      }

      .edit-btn {
        background: none;
        border: 1px solid #6c5ce7;
        padding: 0.4rem 0.8rem;
        border-radius: 4px;
        color: #6c5ce7;
        cursor: pointer;
        font-size: 0.85rem;
        transition: all 0.2s ease;
      }

      .edit-btn:hover {
        background: #6c5ce7;
        color: white;
      }

      .section-content {
        padding: 1.5rem;
      }

      .form-group {
        margin-bottom: 1rem;
      }

      .form-label {
        display: block;
        margin-bottom: 0.4rem;
        font-weight: 500;
        color: #333;
        font-size: 0.9rem;
      }

      .form-control {
        width: 100%;
        padding: 0.6rem;
        border: 1px solid #ddd;
        border-radius: 4px;
        font-size: 0.95rem;
        background: white;
      }

      .form-control:focus {
        outline: none;
        border-color: #6c5ce7;
      }

      .form-control:disabled {
        background: #f8f9fa;
        color: #666;
      }

      .btn-primary {
        background: #6c5ce7;
        border: 1px solid #6c5ce7;
        padding: 0.6rem 1.2rem;
        border-radius: 4px;
        color: white;
        font-weight: 500;
        cursor: pointer;
        font-size: 0.9rem;
        margin-right: 0.5rem;
      }

      .btn-primary:hover {
        background: #5a4fcf;
        border-color: #5a4fcf;
      }

      .btn-secondary {
        background: #6c757d;
        border: 1px solid #6c757d;
        padding: 0.6rem 1.2rem;
        border-radius: 4px;
        color: white;
        cursor: pointer;
        font-size: 0.9rem;
      }

      .btn-outline {
        background: none;
        border: 1px solid #ddd;
        padding: 0.6rem 1.2rem;
        border-radius: 4px;
        color: #333;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        font-size: 0.9rem;
      }

      .btn-outline:hover {
        background: #f8f9fa;
        color: #333;
        text-decoration: none;
      }

      .wallet-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-bottom: 1.5rem;
      }

      .wallet-action {
        background: #1a1a2e;
        color: white;
        padding: 1rem;
        border-radius: 6px;
        text-align: center;
        cursor: pointer;
        border: none;
        font-size: 0.9rem;
      }

      .wallet-action:hover {
        background: #2c2c54;
        color: white;
      }

      .wallet-action i {
        font-size: 1.2rem;
        margin-bottom: 0.3rem;
        display: block;
      }

      .balance-display {
        background: #6c5ce7;
        color: white;
        padding: 1.25rem;
        border-radius: 6px;
        text-align: center;
        margin-bottom: 1.5rem;
      }

      .balance-label {
        font-size: 0.85rem;
        margin-bottom: 0.25rem;
        opacity: 0.9;
      }

      .balance-amount {
        font-size: 1.5rem;
        font-weight: 700;
        margin: 0;
      }

      .recent-transactions {
        max-height: 200px;
        overflow-y: auto;
      }

      .transaction-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.75rem 0;
        border-bottom: 1px solid #f0f0f0;
      }

      .transaction-item:last-child {
        border-bottom: none;
      }

      .transaction-desc {
        font-weight: 500;
        color: #333;
        font-size: 0.9rem;
      }

      .transaction-date {
        font-size: 0.8rem;
        color: #666;
      }

      .transaction-amount {
        font-weight: 600;
        font-size: 0.9rem;
      }

      .amount-positive {
        color: #27ae60;
      }

      .amount-negative {
        color: #e74c3c;
      }

      .support-links {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0.75rem;
      }

      .support-link {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem;
        border: 1px solid #e5e5e5;
        border-radius: 6px;
        color: #333;
        text-decoration: none;
        font-size: 0.9rem;
      }

      .support-link:hover {
        background: #f8f9fa;
        color: #333;
        text-decoration: none;
      }

      .support-icon {
        color: #6c5ce7;
        font-size: 1rem;
      }

      .hidden {
        display: none;
      }

      .subscription-info {
        background: #f8f9fa;
        border: 1px solid #e5e5e5;
        border-radius: 6px;
        padding: 1rem;
        margin-bottom: 1rem;
      }

      .subscription-info.premium {
        background: #6c5ce7;
        color: white;
        border-color: #6c5ce7;
      }

      .sub-title {
        font-size: 1rem;
        font-weight: 600;
        margin-bottom: 0.25rem;
      }

      .sub-details {
        font-size: 0.85rem;
        opacity: 0.8;
      }

      .hidden-file-input {
        display: none;
      }

      .loading-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        display: none;
        z-index: 9999;
        align-items: center;
        justify-content: center;
      }

      .loading-content {
        background: white;
        padding: 2rem;
        border-radius: 8px;
        text-align: center;
        min-width: 200px;
      }

      .loading-spinner {
        width: 30px;
        height: 30px;
        border: 3px solid #f3f3f3;
        border-top: 3px solid #6c5ce7;
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin: 0 auto 1rem;
      }

      @keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
      }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <!-- Sidebar -->
      <%- include('partials/sidebar'); %>
      <!-- End Sidebar -->

      <div class="main-panel">
        <!-- header starts -->
        <%- include('partials/header') %>
        <!-- header ends -->

        <div class="container">
          <div class="page-inner">
            <div class="profile-container">
              
              <!-- Profile Header -->
              <div class="profile-header">
                <div class="profile-info">
                  <div class="avatar-container">
                    <div class="profile-avatar" id="profileAvatar">
                      <i class="fas fa-user"></i>
                    </div>
                    <div class="avatar-upload" onclick="document.getElementById('avatarInput').click()">
                      <i class="fas fa-camera"></i>
                    </div>
                    <input type="file" id="avatarInput" class="hidden-file-input" accept="image/*">
                  </div>
                  <div class="user-details">
                    <h2 id="userName">Loading...</h2>
                    <div class="user-email" id="userEmail">Loading...</div>
                    <div class="user-meta">
                      <div class="meta-item">
                        Member since <span id="memberSince">Loading...</span>
                      </div>
                      <span id="premiumBadge" class="free-badge">Free</span>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Personal Information Section -->
              <div class="section-card">
                <div class="section-header">
                  <div class="section-title">
                    <i class="fas fa-user section-icon"></i>
                    Personal Information
                  </div>
                  <button class="edit-btn" onclick="toggleEditMode('personal')">
                    <i class="fas fa-edit"></i> Edit
                  </button>
                </div>
                <div class="section-content">
                  <div class="row">
                    <div class="col-md-6">
                      <div class="form-group">
                        <label class="form-label">First Name</label>
                        <input type="text" class="form-control" id="firstName" disabled>
                      </div>
                    </div>
                    <div class="col-md-6">
                      <div class="form-group">
                        <label class="form-label">Last Name</label>
                        <input type="text" class="form-control" id="lastName" disabled>
                      </div>
                    </div>
                  </div>
                  <div class="form-group">
                    <label class="form-label">Email Address</label>
                    <input type="email" class="form-control" id="email" disabled>
                    <small style="color: #666; font-size: 0.8rem;">Email can be changed from account settings</small>
                  </div>
                  <div id="personalActions" class="hidden">
                    <button type="button" class="btn-primary" onclick="savePersonalInfo()">Save Changes</button>
                    <button type="button" class="btn-secondary" onclick="cancelEdit('personal')">Cancel</button>
                  </div>
                </div>
              </div>

              <!-- Quick Wallet Section -->
              <div class="section-card">
                <div class="section-header">
                  <div class="section-title">
                    <i class="fas fa-wallet section-icon"></i>
                    Wallet Overview
                  </div>
                  <a href="/dashboard/wallet" style="color: #6c5ce7; text-decoration: none; font-size: 0.85rem;">
                    <i class="fas fa-external-link-alt"></i> View Full Wallet
                  </a>
                </div>
                <div class="section-content">
                  <div class="row" style="margin-bottom: 1.5rem;">
                    <div class="col-md-4">
                      <div style="background: #6c5ce7; color: white; padding: 1rem; border-radius: 6px; text-align: center;">
                        <div style="font-size: 0.8rem; opacity: 0.9; margin-bottom: 0.25rem;">Cash Balance</div>
                        <div style="font-size: 1.3rem; font-weight: 700;" id="cashBalance">$0.00</div>
                      </div>
                    </div>
                    <div class="col-md-4">
                      <div style="background: #1a1a2e; color: white; padding: 1rem; border-radius: 6px; text-align: center;">
                        <div style="font-size: 0.8rem; opacity: 0.9; margin-bottom: 0.25rem;">Investments</div>
                        <div style="font-size: 1.3rem; font-weight: 700;" id="investmentValue">$0.00</div>
                      </div>
                    </div>
                    <div class="col-md-4">
                      <div style="background: #f8f9fa; border: 1px solid #e5e5e5; color: #333; padding: 1rem; border-radius: 6px; text-align: center;">
                        <div style="font-size: 0.8rem; margin-bottom: 0.25rem; color: #666;">Total Portfolio</div>
                        <div style="font-size: 1.3rem; font-weight: 700;" id="totalPortfolio">$0.00</div>
                      </div>
                    </div>
                  </div>
                  
                  <div class="wallet-actions">
                    <button class="wallet-action" onclick="openDepositModal()">
                      <i class="fas fa-plus"></i>
                      Add Money
                    </button>
                    <button class="wallet-action" onclick="openWithdrawModal()">
                      <i class="fas fa-minus"></i>
                      Withdraw
                    </button>
                  </div>

                  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                    <h6 style="margin: 0; font-size: 0.9rem;">Recent Activity</h6>
                    <a href="/dashboard/transactions" style="color: #6c5ce7; text-decoration: none; font-size: 0.8rem;">
                      View All
                    </a>
                  </div>
                  <div class="recent-transactions" id="recentTransactions">
                    <div style="text-align: center; padding: 1rem; color: #666;">
                      Loading transactions...
                    </div>
                  </div>
                </div>
              </div>

              <!-- Account Settings Section -->
              <div class="section-card">
                <div class="section-header">
                  <div class="section-title">
                    <i class="fas fa-cog section-icon"></i>
                    Account Settings
                  </div>
                </div>
                <div class="section-content">
                  <p style="margin-bottom: 1rem; font-size: 0.9rem; color: #666;">Manage your account security and preferences.</p>
                  <a href="/logoutt" class="btn-outline">
                    <i class="fas fa-key"></i> Change Password
                  </a>
                </div>
              </div>

              <!-- Subscription Section -->
              <div class="section-card">
                <div class="section-header">
                  <div class="section-title">
                    <i class="fas fa-crown section-icon"></i>
                    Subscription
                  </div>
                </div>
                <div class="section-content">
                  <div id="subscriptionInfo" class="subscription-info">
                    <div class="sub-title">Free Plan</div>
                    <div class="sub-details">Basic access to investment features</div>
                  </div>
                </div>
              </div>

              <!-- Support Section -->
              <div class="section-card">
                <div class="section-header">
                  <div class="section-title">
                    <i class="fas fa-life-ring section-icon"></i>
                    Support
                  </div>
                </div>
                <div class="section-content">
                  <div class="support-links">
                    <a href="#" class="support-link" onclick="downloadTransactionHistory()">
                      <i class="fas fa-download support-icon"></i>
                      Download Transaction History
                    </a>
                    <a href="/support" class="support-link">
                      <i class="fas fa-headset support-icon"></i>
                      Contact Support
                    </a>
                    <a href="/help" class="support-link">
                      <i class="fas fa-question-circle support-icon"></i>
                      Help Center
                    </a>
