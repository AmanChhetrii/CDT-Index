<style>
/* Override existing styles with dark violet theme */
.sidebar {
  background-color: #1a0d3d !important;
}

.logo-header {
  background-color: #1a0d3d !important;
}

/* Better active state styling with lighter violet shade */
.nav-item.active > a {
  background-color: #2d1b69 !important;
  color: #ffffff !important;
  border-left: 3px solid #4a3585;
  border-radius: 0;
}

.nav-item.active > a i {
  color: #ffffff !important;
}

/* Default state styling */
.nav-item > a {
  color: #a395c7 !important;
  transition: all 0.3s ease;
}

.nav-item > a i {
  color: #7a6ba8 !important;
}

/* Hover effects */
.nav-item:not(.active) > a:hover {
  background-color: #2d1b69 !important;
  color: #ffffff !important;
  transform: translateX(5px);
}

.nav-item:not(.active) > a:hover i {
  color: #ffffff !important;
}

/* Text section styling */
.text-section {
  color: #7a6ba8 !important;
}

/* Button styling for toggles */
.btn-toggle {
  color: #a395c7 !important;
}

.btn-toggle:hover {
  color: #ffffff !important;
}
</style>

<script>
// Active tab functionality - add this script to each page
document.addEventListener('DOMContentLoaded', function() {
    // Remove active class from all nav items
    document.querySelectorAll('.nav-item').forEach(item => {
        item.classList.remove('active');
    });
    
    // Get current page from URL
    const currentPath = window.location.pathname;
    let activeNavId = '';
    
    // Determine which nav item should be active based on current path
    if (currentPath === '/dashboard' || currentPath === '/dashboard/') {
        activeNavId = 'nav-dashboard';
    } else if (currentPath.includes('/transactions')) {
        activeNavId = 'nav-transactions';
    } else if (currentPath.includes('/explore')) {
        activeNavId = 'nav-explore';
    } else if (currentPath.includes('/wallet')) {
        activeNavId = 'nav-wallet';
    } else if (currentPath.includes('/premium')) {
        activeNavId = 'nav-premium';
    } else if (currentPath.includes('/profile')) {
        activeNavId = 'nav-profile';
    } else if (currentPath.includes('/widgets')) {
        activeNavId = 'nav-widgets';
    }
    
    // Add active class to the current page's nav item
    if (activeNavId) {
        const activeNav = document.getElementById(activeNavId);
        if (activeNav) {
            activeNav.classList.add('active');
        }
    }
});
</script>