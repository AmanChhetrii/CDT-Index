<div class="main-header">
  <div class="main-header-logo">
    <!-- Logo Header -->
    <div class="logo-header" data-background-color="dark">
      <a href="/dashboard" class="logo">
        <img
          src="/dashboard/img/kaiadmin/logo_light.svg"
          alt="navbar brand"
          class="navbar-brand"
          height="20"
        />
      </a>
      <div class="nav-toggle">
        <button class="btn btn-toggle toggle-sidebar">
          <i class="gg-menu-right"></i>
        </button>
        <button class="btn btn-toggle sidenav-toggler">
          <i class="gg-menu-left"></i>
        </button>
      </div>
      <button class="topbar-toggler more">
        <i class="gg-more-vertical-alt"></i>
      </button>
    </div>
    <!-- End Logo Header -->
  </div>
  <!-- Navbar Header -->
  <nav
    class="navbar navbar-header navbar-header-transparent navbar-expand-lg border-bottom"
  >
    <div class="container-fluid">
      <nav
        class="navbar navbar-header-left navbar-expand-lg navbar-form nav-search p-0 d-none d-lg-flex"
      >
        <div class="input-group">
          <div class="input-group-prepend">
            <button type="submit" class="btn btn-search pe-1">
              <i class="fa fa-search search-icon"></i>
            </button>
          </div>
          <input
            type="text"
            placeholder="Search ..."
            class="form-control"
          />
        </div>
      </nav>

      <ul class="navbar-nav topbar-nav ms-md-auto align-items-center">
        <li
          class="nav-item topbar-icon dropdown hidden-caret d-flex d-lg-none"
        >
          <a
            class="nav-link dropdown-toggle"
            data-bs-toggle="dropdown"
            href="#"
            role="button"
            aria-expanded="false"
            aria-haspopup="true"
          >
            <i class="fa fa-search"></i>
          </a>
          <ul class="dropdown-menu dropdown-search animated fadeIn">
            <form class="navbar-left navbar-form nav-search">
              <div class="input-group">
                <input
                  type="text"
                  placeholder="Search ..."
                  class="form-control"
                />
              </div>
            </form>
          </ul>
        </li>

        <li class="nav-item topbar-icon dropdown hidden-caret">
          <a
            class="nav-link dropdown-toggle"
            href="#"
            id="notifDropdown"
            role="button"
            data-bs-toggle="dropdown"
            aria-haspopup="true"
            aria-expanded="false"
          >
            <i class="fa fa-bell"></i>
            <span class="notification">1</span>
          </a>
          <ul
            class="dropdown-menu notif-box animated fadeIn"
            aria-labelledby="notifDropdown"
          >
            <li>
              <div class="dropdown-title">
                You have 1 new notification
              </div>
            </li>
            <li>
              <div class="notif-scroll scrollbar-outer">
                <div class="notif-center">
                  <a href="#">
                    <div class="notif-icon notif-warning">
                      <i class="fas fa-cogs"></i>
                    </div>
                    <div class="notif-content">
                      <span class="block">Custom Fund Building - Coming Soon</span>
                      <span class="time">New feature</span>
                    </div>
                  </a>
                </div>
              </div>
            </li>
          </ul>
        </li>

        <li class="nav-item topbar-user dropdown hidden-caret">
          <a
            class="dropdown-toggle profile-pic"
            data-bs-toggle="dropdown"
            href="#"
            aria-expanded="false"
          >
            <div class="avatar-sm">
              <% if (typeof user !== 'undefined' && user && user.profilePhoto) { %>
                <img src="<%= user.profilePhoto %>?t=<%= Date.now() %>" alt="Profile" style="width: 36px; height: 36px; border-radius: 50%; object-fit: cover;" />
              <% } else { %>
                <div id="headerUserAvatar" style="width: 36px; height: 36px; border-radius: 50%; background: #6c5ce7; display: flex; align-items: center; justify-content: center; color: white; font-weight: 600; font-size: 14px;">
                  <% if (typeof user !== 'undefined' && user) { %>
                    <%= (user.firstName.charAt(0) + (user.lastName ? user.lastName.charAt(0) : '')).toUpperCase() %>
                  <% } else { %>
                    U
                  <% } %>
                </div>
              <% } %>
            </div>
            <span class="profile-username">
              <span class="op-7">Hi,</span>
              <span class="fw-bold">
                <% if (typeof user !== 'undefined' && user) { %>
                  <%= user.firstName %>
                <% } else { %>
                  Hizrian
                <% } %>
              </span>
            </span>
          </a>
          <ul class="dropdown-menu dropdown-user animated fadeIn">
            <div class="dropdown-user-scroll scrollbar-outer">
              <li>
                <div class="user-box">
                  <div class="avatar-lg">
                    <% if (typeof user !== 'undefined' && user && user.profilePhoto) { %>
                      <img src="<%= user.profilePhoto %>?t=<%= Date.now() %>" alt="Profile" style="width: 60px; height: 60px; border-radius: 8px; object-fit: cover;" />
                    <% } else { %>
                      <div id="headerUserAvatarLarge" style="width: 60px; height: 60px; border-radius: 8px; background: #6c5ce7; display: flex; align-items: center; justify-content: center; color: white; font-weight: 600; font-size: 24px;">
                        <% if (typeof user !== 'undefined' && user) { %>
                          <%= (user.firstName.charAt(0) + (user.lastName ? user.lastName.charAt(0) : '')).toUpperCase() %>
                        <% } else { %>
                          U
                        <% } %>
                      </div>
                    <% } %>
                  </div>
                  <div class="u-text">
                    <h4>
                      <% if (typeof user !== 'undefined' && user) { %>
                        <%= user.firstName %> <%= user.lastName || '' %>
                      <% } else { %>
                        Hizrian
                      <% } %>
                    </h4>
                    <p class="text-muted" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 200px;">
                      <% if (typeof user !== 'undefined' && user) { %>
                        <%= user.email %>
                      <% } else { %>
                        hello@example.com
                      <% } %>
                    </p>
                    <a
                      href="/dashboard/profile"
                      class="btn btn-xs btn-secondary btn-sm"
                      >View Profile</a
                    >
                  </div>
                </div>
              </li>
              <li>
                <div class="dropdown-divider"></div>
                <a class="dropdown-item" href="/dashboard/profile">My Profile</a>
                <a class="dropdown-item" href="/dashboard/wallet">My Balance</a>
                <a class="dropdown-item" href="#">Inbox</a>
                <div class="dropdown-divider"></div>
                <a class="dropdown-item" href="/dashboard/reset-pass">Account Setting</a>
                <div class="dropdown-divider"></div>
                <a class="dropdown-item" href="/logout">Logout</a>
              </li>
            </div>
          </ul>
        </li>
      </ul>
    </div>
  </nav>
  <!-- End Navbar -->
</div>

<!-- User Data for Header -->
<script type="application/json" id="header-user-data">
  <%- JSON.stringify(typeof user !== 'undefined' && user ? {
    firstName: user.firstName,
    lastName: user.lastName,  
    email: user.email,
    profilePhoto: user.profilePhoto
  } : null) %>
</script>

<script>
// Header user data loading - same method as profile page
$(document).ready(function() {
  console.log('Header JavaScript starting...');
  loadHeaderUserData();
});

function loadHeaderUserData() {
  try {
    console.log('Loading header user data...');
    
    const userDataElement = document.getElementById('header-user-data');
    const headerUser = userDataElement ? JSON.parse(userDataElement.textContent) : null;
    
    console.log('Header user data parsed:', headerUser);
    
    if (headerUser) {
      // Update avatars with profile photos
      if (headerUser.profilePhoto) {
        console.log('User has profile photo:', headerUser.profilePhoto);
        
        const avatarImg = '<img src="' + headerUser.profilePhoto + '?t=' + Date.now() + '" alt="Profile" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;">';
        const avatarLargeImg = '<img src="' + headerUser.profilePhoto + '?t=' + Date.now() + '" alt="Profile" style="width: 100%; height: 100%; border-radius: 8px; object-fit: cover;">';
        
        const smallAvatar = document.getElementById('headerUserAvatar');
        const largeAvatar = document.getElementById('headerUserAvatarLarge');
        
        if (smallAvatar) {
          console.log('Updating small avatar');
          smallAvatar.innerHTML = avatarImg;
        } else {
          console.log('Small avatar element not found');
        }
        
        if (largeAvatar) {
          console.log('Updating large avatar');
          largeAvatar.innerHTML = avatarLargeImg;
        } else {
          console.log('Large avatar element not found');
        }
        
      } else {
        console.log('User has no profile photo, using initials');
        const initials = (headerUser.firstName.charAt(0) + (headerUser.lastName ? headerUser.lastName.charAt(0) : '')).toUpperCase();
        
        const smallAvatar = document.getElementById('headerUserAvatar');
        const largeAvatar = document.getElementById('headerUserAvatarLarge');
        
        if (smallAvatar) {
          smallAvatar.textContent = initials;
        }
        if (largeAvatar) {
          largeAvatar.textContent = initials;
        }
      }
    } else {
      console.log('No header user data available');
    }
  } catch (error) {
    console.error('Error in loadHeaderUserData:', error);
  }
}
</script>