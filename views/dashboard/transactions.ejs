<!DOCTYPE html>
<html lang="en">
  <head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>CDT Index - Dashboard</title>
    <meta
      content="width=device-width, initial-scale=1.0, shrink-to-fit=no"
      name="viewport"
    />
    <link
      rel="icon"
      href="/dashboard/img/kaiadmin/favicon.ico"
      type="image/x-icon"
    />

    <!-- Fonts and icons -->
    <script src="/dashboard/js/plugin/webfont/webfont.min.js"></script>
    <script>
      WebFont.load({
        google: { families: ["Public Sans:300,400,500,600,700"] },
        custom: {
          families: [
            "Font Awesome 5 Solid",
            "Font Awesome 5 Regular",
            "Font Awesome 5 Brands",
            "simple-line-icons",
          ],
          urls: ["/dashboard/css/fonts.min.css"],
        },
        active: function () {
          sessionStorage.fonts = true;
        },
      });
    </script>

    <!-- CSS Files -->
    <link rel="stylesheet" href="/dashboard/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/dashboard/css/plugins.min.css" />
    <link rel="stylesheet" href="/dashboard/css/kaiadmin.min.css" />
    <link rel="stylesheet" href="/dashboard/css/dark-theme.css" />

    <!-- Enhanced Dashboard Styling -->
    <style>
      .fund-card {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
      }
      
      .fund-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);
        transition: left 0.5s;
      }
      
      .fund-card:hover::before {
        left: 100%;
      }
      
      .fund-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.3);
      }

      .fund-card.cdtgr {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      }
      
      .fund-card.cdtbal {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
      }
      
      .fund-card.cdtpio {
        background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
      }
      
      .fund-card.cdtarc {
        background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
      }

      .crypto-icon {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        margin-right: 8px;
      }

      .performance-chart {
        background: rgba(255,255,255,0.1);
        backdrop-filter: blur(10px);
        border-radius: 15px;
        border: 1px solid rgba(255,255,255,0.2);
      }

      .market-overview-card {
        background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
        color: white;
        border: none;
      }

      .nav-value {
        font-size: 2rem;
        font-weight: 700;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
      }

      .change-positive {
        color: #10b981;
      }

      .change-negative {
        color: #ef4444;
      }

      .composition-bar {
        height: 8px;
        border-radius: 4px;
        background: rgba(255,255,255,0.3);
        margin: 5px 0;
      }

      .pulse-animation {
        animation: pulse 2s infinite;
      }

      @keyframes pulse {
        0% { transform: scale(1); }
        50% { transform: scale(1.05); }
        100% { transform: scale(1); }
      }

      .glow-text {
        text-shadow: 0 0 10px rgba(255,255,255,0.5);
      }

      .transaction-row:hover {
        background: rgba(59, 130, 246, 0.1);
        transform: scale(1.02);
        transition: all 0.2s ease;
      }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <!-- Sidebar -->
      <%- include('partials/sidebar'); %>
      <!-- End Sidebar -->

      <div class="main-panel">
        <!-- header starts -->
        <%- include('partials/header') %>
        <!-- header ends -->

        <div class="container">
          <div class="page-inner">
            <div class="d-flex align-items-left align-items-md-center flex-column flex-md-row pt-2 pb-4">
              <div>
                <h3 class="fw-bold mb-3 glow-text">Portfolio Dashboard</h3>
                <h6 class="op-7 mb-2">Real-time Crypto Index Fund Performance</h6>
              </div>
              <div class="ms-md-auto py-2 py-md-0">
                <a href="#" class="btn btn-label-info btn-round me-2">
                  <i class="fa fa-chart-line me-1"></i>Analytics
                </a>
                <a href="#" class="btn btn-primary btn-round pulse-animation">
                  <i class="fa fa-plus me-1"></i>Invest Now
                </a>
              </div>
            </div>
            
            <!-- Recent Transactions -->
            <div class="row">
              <div class="col-md-12">
                <div class="card card-round">
                  <div class="card-header">
                    <div class="card-head-row card-tools-still-right">
                      <div class="card-title">Recent Transactions</div>
                      <div class="card-tools">
                        <a href="#" class="btn btn-label-success btn-round btn-sm">
                          <i class="fa fa-download"></i> Export
                        </a>
                      </div>
                    </div>
                  </div>
                  <div class="card-body p-0">
                    <div class="table-responsive">
                      <table class="table align-items-center mb-0">
                        <thead class="thead-light">
                          <tr>
                            <th scope="col">Fund</th>
                            <th scope="col">Type</th>
                            <th scope="col" class="text-end">Amount</th>
                            <th scope="col" class="text-end">NAV Price</th>
                            <th scope="col" class="text-end">Date</th>
                            <th scope="col" class="text-end">Status</th>
                          </tr>
                        </thead>
                        <tbody>
                          <tr class="transaction-row">
                            <td>
                              <div class="d-flex align-items-center">
                                <div class="fund-card cdtgr" style="width: 8px; height: 30px; margin-right: 12px; border-radius: 4px;"></div>
                                <span class="fw-bold">CDT Growth</span>
                              </div>
                            </td>
                            <td><span class="badge badge-success">BUY</span></td>
                            <td class="text-end">$2,500.00</td>
                            <td class="text-end">$125.32</td>
                            <td class="text-end">Sep 08, 2025</td>
                            <td class="text-end"><span class="badge badge-success">Completed</span></td>
                          </tr>
                          <tr class="transaction-row">
                            <td>
                              <div class="d-flex align-items-center">
                                <div class="fund-card cdtbal" style="width: 8px; height: 30px; margin-right: 12px; border-radius: 4px;"></div>
                                <span class="fw-bold">CDT Balanced</span>
                              </div>
                            </td>
                            <td><span class="badge badge-info">BUY</span></td>
                            <td class="text-end">$1,000.00</td>
                            <td class="text-end">$106.45</td>
                            <td class="text-end">Sep 07, 2025</td>
                            <td class="text-end"><span class="badge badge-success">Completed</span></td>
                          </tr>
                          <tr class="transaction-row">
                            <td>
                              <div class="d-flex align-items-center">
                                <div class="fund-card cdtpio" style="width: 8px; height: 30px; margin-right: 12px; border-radius: 4px;"></div>
                                <span class="fw-bold">CDT Pioneer</span>
                              </div>
                            </td>
                            <td><span class="badge badge-warning">SELL</span></td>
                            <td class="text-end">$500.00</td>
                            <td class="text-end">$110.22</td>
                            <td class="text-end">Sep 06, 2025</td>
                            <td class="text-end"><span class="badge badge-success">Completed</span></td>
                          </tr>
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- footer starts -->
        <%- include('partials/footer') %>
        <!-- footer ends -->
      </div>
    </div>

    <!--   Core JS Files   -->
    <script src="/dashboard/js/core/jquery-3.7.1.min.js"></script>
    <script src="/dashboard/js/core/popper.min.js"></script>
    <script src="/dashboard/js/core/bootstrap.min.js"></script>
    <script src="/dashboard/js/plugin/jquery-scrollbar/jquery.scrollbar.min.js"></script>
    <script src="/dashboard/js/plugin/chart.js/chart.min.js"></script>
    <script src="/dashboard/js/plugin/jquery.sparkline/jquery.sparkline.min.js"></script>
    <script src="/dashboard/js/plugin/chart-circle/circles.min.js"></script>
    <script src="/dashboard/js/plugin/datatables/datatables.min.js"></script>
    <script src="/dashboard/js/plugin/bootstrap-notify/bootstrap-notify.min.js"></script>
    <script src="/dashboard/js/plugin/jsvectormap/jsvectormap.min.js"></script>
    <script src="/dashboard/js/plugin/jsvectormap/world.js"></script>
    <script src="/dashboard/js/plugin/sweetalert/sweetalert.min.js"></script>
    <script src="/dashboard/js/kaiadmin.min.js"></script>

    <script>
      // Enhanced Portfolio Chart
      const ctx = document.getElementById('portfolioChart').getContext('2d');
      const gradient = ctx.createLinearGradient(0, 0, 0, 400);
      gradient.addColorStop(0, 'rgba(59, 130, 246, 0.4)');
      gradient.addColorStop(1, 'rgba(59, 130, 246, 0.0)');

      new Chart(ctx, {
        type: 'line',
        data: {
          labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep'],
          datasets: [{
            label: 'Portfolio Value',
            data: [37000, 39000, 41000, 38000, 42000, 45000, 43000, 46000, 45892],
            borderColor: '#3b82f6',
            backgroundColor: gradient,
            borderWidth: 3,
            fill: true,
            tension: 0.4,
            pointBackgroundColor: '#3b82f6',
            pointBorderColor: '#ffffff',
            pointBorderWidth: 2,
            pointRadius: 6,
            pointHoverRadius: 8
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              display: false
            }
          },
          scales: {
            x: {
              grid: {
                display: false
              },
              ticks: {
                color: '#9ca3af'
              }
            },
            y: {
              grid: {
                color: 'rgba(156, 163, 175, 0.1)'
              },
              ticks: {
                color: '#9ca3af',
                callback: function(value) {
                  return '$' + (value / 1000) + 'k';
                }
              }
            }
          },
          interaction: {
            intersect: false,
            mode: 'index'
          }
        }
      });

      // Add some interactive effects
      document.querySelectorAll('.transaction-row').forEach(row => {
        row.addEventListener('mouseenter', function() {
          this.style.backgroundColor = 'rgba(59, 130, 246, 0.1)';
        });
        
        row.addEventListener('mouseleave', function() {
          this.style.backgroundColor = '';
        });
      });

      // Simulate real-time updates
      setInterval(() => {
        document.querySelectorAll('.nav-value').forEach(el => {
          const currentValue = parseFloat(el.textContent.replace('$', ''));
          const change = (Math.random() - 0.5) * 0.5;
          const newValue = currentValue + change;
          el.textContent = '$' + newValue.toFixed(2);
        });
      }, 5000);
    </script>
  </body>
</html>