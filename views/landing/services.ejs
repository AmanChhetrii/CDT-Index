<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="description" content="CDT Index Services - Professional Crypto Index Funds">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    
    <!-- Title -->
    <title>Our Services - CDT Index</title>

    <!-- Favicon -->
    <link rel="icon" href="/img/core-img/logo_smallbg.png">

    <!-- Core Stylesheet -->
    <link rel="stylesheet" href="/style.css">

</head>

<body>
   <!-- header starts here -->
    <%- include('partials/header') %>
    <!-- ##### Header Area End ##### -->
    
    <style>
        /* Modern Futuristic Styles matching home page */
        :root {
            --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            --accent-gradient: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            --dark-gradient: linear-gradient(135deg, #120A8F 0%, #0A0654 50%, #1E1A5C 100%);
            --glow-color: #f8d733;
            --text-glow: 0 0 20px rgba(238, 212, 61, 0.875);
            --gold-color: #FFD700;
        }
        
        /* Hero area with deep blue tones */
        .hero-area {
            background: linear-gradient(135deg, #041235 0%, #0F0525 100%);
            position: relative;
            overflow: hidden;
        }
        
        /* Particle.js container */
        #particles-hero,
        #particles-funds,
        #particles-services {
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            z-index: 1;
        }
        
        /* Glowing text effects */
        .glow-text {
            text-shadow: var(--text-glow);
            animation: pulseGlow 3s ease-in-out infinite alternate;
        }
        
        @keyframes pulseGlow {
            from { text-shadow: 0 0 20px rgba(255, 215, 0, 0.6); }
            to { text-shadow: 0 0 30px rgba(255, 215, 0, 0.9); }
        }
        
        /* Fund Cards matching home page style */
        .fund-card {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            padding: 2.5rem;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
        
        .fund-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(0, 212, 255, 0.1), transparent);
            transition: left 0.5s;
        }
        
        .fund-card:hover::before {
            left: 100%;
        }
        
        .fund-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(197, 152, 3, 0.3);
            border-color: var(--glow-color);
        }
        
        .fund-header {
            margin-bottom: 1.5rem;
        }
        
        .fund-name {
            color: white;
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 0.75rem;
        }
        
        .fund-tagline {
            color: var(--glow-color);
            font-size: 1rem;
            font-weight: 600;
            margin-bottom: 1rem;
        }
        
        .fund-description {
            color: rgba(255, 255, 255, 0.8);
            line-height: 1.7;
            margin-bottom: 1.5rem;
            flex-grow: 1;
        }
        
        .fund-details {
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            padding-top: 1.5rem;
            margin-bottom: 1.5rem;
        }
        
        .fund-detail {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 0.75rem;
            font-size: 0.9rem;
        }
        
        .fund-detail-label {
            color: rgba(255, 255, 255, 0.6);
        }
        
        .fund-detail-value {
            color: rgba(255, 255, 255, 0.9);
            font-weight: 500;
        }
        
        .risk-level {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 15px;
            font-size: 0.8rem;
            font-weight: 500;
            border: 1px solid;
        }
        
        .risk-aggressive {
            background: rgba(239, 68, 68, 0.2);
            color: #f87171;
            border-color: rgba(239, 68, 68, 0.4);
        }
        
        .risk-moderate {
            background: rgba(251, 191, 36, 0.2);
            color: #fbbf24;
            border-color: rgba(251, 191, 36, 0.4);
        }
        
        .risk-conservative {
            background: rgba(34, 197, 94, 0.2);
            color: #4ade80;
            border-color: rgba(34, 197, 94, 0.4);
        }
        
        .risk-high {
            background: rgba(239, 68, 68, 0.2);
            color: #f87171;
            border-color: rgba(239, 68, 68, 0.4);
        }
        
        /* Modern buttons matching home page */
        .modern-btn {
            background: var(--primary-gradient);
            border: none;
            border-radius: 50px;
            padding: 12px 30px;
            color: white;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
            text-align: center;
            font-size: 0.9rem;
        }
        
        .modern-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(102, 126, 234, 0.4);
            color: white;
            text-decoration: none;
        }
        
        /* Service Cards */
        .service-card {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 15px;
            padding: 2rem;
            text-align: center;
            transition: all 0.3s ease;
            height: 100%;
        }
        
        .service-card:hover {
            transform: translateY(-5px);
            border-color: rgba(255, 215, 0, 0.3);
            box-shadow: 0 10px 30px rgba(255, 215, 0, 0.1);
        }
        
        .service-icon {
            font-size: 2.5rem;
            color: var(--glow-color);
            margin-bottom: 1.5rem;
        }
        
        .service-title {
            color: white;
            font-size: 1.25rem;
            font-weight: 600;
            margin-bottom: 1rem;
        }
        
        .service-description {
            color: rgba(255, 255, 255, 0.8);
            line-height: 1.6;
            margin-bottom: 1.5rem;
        }
        
        .service-link {
            color: var(--glow-color);
            text-decoration: none;
            font-weight: 500;
            font-size: 0.9rem;
            display: inline-flex;
            align-items: center;
            transition: color 0.2s ease;
        }
        
        .service-link:hover {
            color: white;
            text-decoration: none;
        }
        
        .service-link::after {
            content: '→';
            margin-left: 8px;
            transition: transform 0.2s ease;
        }
        
        .service-link:hover::after {
            transform: translateX(4px);
        }
        
        /* Floating elements */
        .floating-element {
            position: absolute;
            opacity: 0.1;
            animation: float 6s ease-in-out infinite;
        }
        
        @keyframes float {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-20px) rotate(180deg); }
        }
        
        /* Responsive Design */
        @media (max-width: 768px) {
            .hero-area {
                text-align: center;
            }
            
            .hero-area h2 {
                font-size: 2.5rem !important;
            }
            
            .hero-area h6 {
                font-size: 1rem !important;
            }
            
            .fund-card, .service-card {
                margin-bottom: 2rem;
            }
            
            .floating-element {
                display: none;
            }
        }
    </style>

