    <script>
        // Store fund data for modal
        const fundData = <%- JSON.stringify(funds) %>;

        function openFundModal(fundSymbol) {
            // Find fund by symbol
            const fund = fundData.find(f => f.symbol === fundSymbol);
            if (!fund) return;

            // Populate modal content
            document.getElementById('modalFundName').textContent = fund.name;
            document.getElementById('modalFundSummary').textContent = fund.summary;
            document.getElementById('modalFundDescription').textContent = fund.description;
            document.getElementById('modalCurrentNAV').textContent = '$' + fund.currentNAVFromDB.toFixed(4);
            document.getElementById('modalInceptionNAV').textContent = '$' + fund.inceptionNAV.toFixed(2);
            
            const totalReturnElement = document.getElementById('modalTotalReturn');
            const returnValue = fund.totalReturnFromDB.toFixed(2);
            totalReturnElement.textContent = (fund.totalReturnFromDB >= 0 ? '+' : '') + returnValue + '%';
            totalReturnElement.style.color = fund.totalReturnFromDB >= 0 ? '#4ade80' : '#f87171';
            
            document.getElementById('modalRiskLevel').textContent = fund.riskLevel;
            document.getElementById('modalFundLink').href = '/funds/' + fund.slug;

            // Populate composition
            const compositionContainer = document.getElementById('modalCompositionGrid');
            compositionContainer.innerHTML = '';
            fund.composition.forEach(coin => {
                const item = document.createElement('div');
                item.className = 'composition-item';
                item.innerHTML = `
                    <span class="crypto-symbol">${coin.symbol}</span>
                    <span class="crypto-weight">${(coin.weight * 100).toFixed(0)}%</span>
                `;
                compositionContainer.appendChild(item);
            });

            // Show modal
            const modal = document.getElementById('fundModal');
            modal.classList.add('show');
            document.body.style.overflow = 'hidden';
        }

        function closeFundModal() {
            const modal = document.getElementById('fundModal');
            modal.classList.remove('show');
            document.body.style.overflow = 'auto';
        }

        // Close modal on backdrop click
        document.addEventListener('click', function(e) {
            if (e.target.classList.contains('modal-backdrop')) {
                closeFundModal();
            }
        });

        // Close modal on escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeFundModal();
            }
        });
    </script>

