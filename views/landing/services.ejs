<body>
   <!-- header starts here -->
    <%- include('partials/header') %>
    <!-- ##### Header Area End ##### -->
    
    <style>
        /* Modern Futuristic Styles matching home page */
        :root {
            --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            --accent-gradient: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            --dark-gradient: linear-gradient(135deg, #120A8F 0%, #0A0654 50%, #1E1A5C 100%);
            --glow-color: #f8d733;
            --text-glow: 0 0 20px rgba(238, 212, 61, 0.875);
            --gold-color: #FFD700;
        }
        
        /* Hero area with deep blue tones */
        .hero-area {
            background: linear-gradient(135deg, #041235 0%, #0F0525 100%);
            position: relative;
            overflow: hidden;
        }
        
        /* Particle.js container */
        #particles-hero,
        #particles-funds,
        #particles-services {
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            z-index: 1;
        }
        
        /* Glowing text effects */
        .glow-text {
            text-shadow: var(--text-glow);
            animation: pulseGlow 3s ease-in-out infinite alternate;
        }
        
        @keyframes pulseGlow {
            from { text-shadow: 0 0 20px rgba(255, 215, 0, 0.6); }
            to { text-shadow: 0 0 30px rgba(255, 215, 0, 0.9); }
        }
        
        /* Fund Cards matching home page style */
        .fund-card {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            padding: 2.5rem;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
        
        .fund-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(0, 212, 255, 0.1), transparent);
            transition: left 0.5s;
        }
        
        .fund-card:hover::before {
            left: 100%;
        }
        
        .fund-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(197, 152, 3, 0.3);
            border-color: var(--glow-color);
        }
        
        .fund-header {
            margin-bottom: 1.5rem;
        }
        
        .fund-name {
            color: white;
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 0.75rem;
        }
        
        .fund-tagline {
            color: var(--glow-color);
            font-size: 1rem;
            font-weight: 600;
            margin-bottom: 1rem;
        }
        
        .fund-description {
            color: rgba(255, 255, 255, 0.8);
            line-height: 1.7;
            margin-bottom: 1.5rem;
            flex-grow: 1;
        }
        
        .fund-details {
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            padding-top: 1.5rem;
            margin-bottom: 1.5rem;
        }
        
        .fund-detail {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 0.75rem;
            font-size: 0.9rem;
        }
        
        .fund-detail-label {
            color: rgba(255, 255, 255, 0.6);
        }
        
        .fund-detail-value {
            color: rgba(255, 255, 255, 0.9);
            font-weight: 500;
        }
        
        .risk-level {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 15px;
            font-size: 0.8rem;
            font-weight: 500;
            border: 1px solid;
        }
        
        .risk-aggressive {
            background: rgba(239, 68, 68, 0.2);
            color: #f87171;
            border-color: rgba(239, 68, 68, 0.4);
        }
        
        .risk-moderate {
            background: rgba(251, 191, 36, 0.2);
            color: #fbbf24;
            border-color: rgba(251, 191, 36, 0.4);
        }
        
        .risk-conservative {
            background: rgba(34, 197, 94, 0.2);
            color: #4ade80;
            border-color: rgba(34, 197, 94, 0.4);
        }
        
        .risk-high {
            background: rgba(239, 68, 68, 0.2);
            color: #f87171;
            border-color: rgba(239, 68, 68, 0.4);
        }
        
        /* Modern buttons matching home page */
        .modern-btn {
            background: var(--primary-gradient);
            border: none;
            border-radius: 50px;
            padding: 12px 30px;
            color: white;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
            text-align: center;
            font-size: 0.9rem;
        }
        
        .modern-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(102, 126, 234, 0.4);
            color: white;
            text-decoration: none;
        }
        
        /* Service Cards */
        .service-card {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 15px;
            padding: 2rem;
            text-align: center;
            transition: all 0.3s ease;
            height: 100%;
        }
        
        .service-card:hover {
            transform: translateY(-5px);
            border-color: rgba(255, 215, 0, 0.3);
            box-shadow: 0 10px 30px rgba(255, 215, 0, 0.1);
        }
        
        .service-icon {
            font-size: 2.5rem;
            color: var(--glow-color);
            margin-bottom: 1.5rem;
        }
        
        .service-title {
            color: white;
            font-size: 1.25rem;
            font-weight: 600;
            margin-bottom: 1rem;
        }
        
        .service-description {
            color: rgba(255, 255, 255, 0.8);
            line-height: 1.6;
            margin-bottom: 1.5rem;
        }
        
        .service-link {
            color: var(--glow-color);
            text-decoration: none;
            font-weight: 500;
            font-size: 0.9rem;
            display: inline-flex;
            align-items: center;
            transition: color 0.2s ease;
        }
        
        .service-link:hover {
            color: white;
            text-decoration: none;
        }
        
        .service-link::after {
            content: '→';
            margin-left: 8px;
            transition: transform 0.2s ease;
        }
        
        .service-link:hover::after {
            transform: translateX(4px);
        }
        
        /* Floating elements */
        .floating-element {
            position: absolute;
            opacity: 0.1;
            animation: float 6s ease-in-out infinite;
        }
        
        @keyframes float {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-20px) rotate(180deg); }
        }
        
        /* Responsive Design */
        @media (max-width: 768px) {
            .hero-area {
                text-align: center;
            }
            
            .hero-area h2 {
                font-size: 2.5rem !important;
            }
            
            .hero-area h6 {
                font-size: 1rem !important;
            }
            
            .fund-card, .service-card {
                margin-bottom: 2rem;
            }
            
            .floating-element {
                display: none;
            }
        }
    </style>

  <!-- ##### Hero Area Start ##### -->
<section class="hero-area" style="min-height: 50vh; display: flex; align-items: center; position: relative; overflow: hidden; background: linear-gradient(135deg, #041235 0%, #0F0525 100%);">
    <div class="hero-container">
        <div class="hero-content-wrapper">
            <div class="hero-text-content">
                <h2>Our <span style="color: rgb(214, 161, 13);">Services</span></h2>
                <h6>CDT Index provides crypto index funds and market insights designed for professional digital asset management.</h6>
            </div>
            
            <div class="hero-abstract-effects">
                <div class="floating-shape"></div>
                <div class="floating-shape"></div>
                <div class="floating-shape"></div>
                <div class="gradient-orb"></div>
                <div class="gradient-orb"></div>
                <div class="hex-pattern"></div>
                <div class="hex-pattern"></div>
                <div class="animated-line"></div>
                <div class="animated-line"></div>
                <div class="gradient-orb"></div>
                <div class="gradient-orb"></div>
                <div class="gradient-orb"></div>
                <div class="gradient-orb"></div>
            </div>
        </div>
    </div>
</section>

<style>

.hero-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
    z-index: 2;
}

.hero-content-wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 4rem;
    min-height: 300px;
}

.hero-text-content {
    padding-right: 2rem;
    transform: translateX(-80px);
}

.hero-area h2 {
    color: white;
    font-size: 4rem;
    margin-bottom: 1.5rem;
    font-weight: 700;
    line-height: 1.1;
}

.hero-area h6 {
    color: rgba(255,255,255,0.9);
    font-size: 1.2rem;
    margin-bottom: 0;
    line-height: 1.6;
    font-weight: 400;
}

/* Abstract Effects Container */
.hero-abstract-effects {
    position: relative;
    height: 300px;
    display: flex;
    align-items: center;
    justify-content: center;
}

/* Floating geometric shapes */
.floating-shape {
    position: absolute;
    border-radius: 50%;
    background: rgba(255, 215, 0, 0.1);
    backdrop-filter: blur(10px);
    animation: float 6s ease-in-out infinite;
    border: 1px solid rgba(255, 215, 0, 0.2);
}

.floating-shape:nth-child(1) {
    width: 120px;
    height: 120px;
    top: 10%;
    right: 20%;
    animation-delay: 0s;
}

.floating-shape:nth-child(2) {
    width: 80px;
    height: 80px;
    top: 60%;
    right: 10%;
    animation-delay: -2s;
}

.floating-shape:nth-child(3) {
    width: 60px;
    height: 60px;
    top: 30%;
    right: 50%;
    animation-delay: -4s;
}

/* Gradient orbs */
.gradient-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(40px);
    opacity: 0.6;
    animation: pulse 8s ease-in-out infinite;
}

.gradient-orb:nth-child(4) {
    width: 200px;
    height: 200px;
    background: radial-gradient(circle, rgba(255,215,0,0.3) 0%, transparent 70%);
    top: 5%;
    right: 15%;
    animation-delay: 0s;
}

.gradient-orb:nth-child(5) {
    width: 150px;
    height: 150px;
    background: radial-gradient(circle, rgba(102,126,234,0.4) 0%, transparent 70%);
    bottom: 10%;
    right: 30%;
    animation-delay: -3s;
}

/* Hexagonal patterns */
.hex-pattern {
    position: absolute;
    width: 40px;
    height: 40px;
    background: rgba(255, 215, 0, 0.05);
    clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
    animation: rotate 20s linear infinite;
    border: 1px solid rgba(255, 215, 0, 0.1);
}

.hex-pattern:nth-child(6) {
    top: 20%;
    right: 40%;
    animation-delay: 0s;
}

.hex-pattern:nth-child(7) {
    bottom: 20%;
    right: 60%;
    animation-delay: -10s;
}

/* Animated lines */
.animated-line {
    position: absolute;
    height: 2px;
    background: linear-gradient(90deg, transparent, rgba(255,215,0,0.3), transparent);
    animation: slide 4s ease-in-out infinite;
}

.animated-line:nth-child(8) {
    width: 150px;
    top: 40%;
    right: 25%;
    animation-delay: 0s;
}

.animated-line:nth-child(9) {
    width: 100px;
    bottom: 30%;
    right: 45%;
    animation-delay: -2s;
}

/* Additional gradient orbs */
.gradient-orb:nth-child(10) {
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(255,215,0,0.15) 0%, transparent 70%);
    top: -5%;
    right: 35%;
    animation-delay: -1s;
    filter: blur(60px);
}

.gradient-orb:nth-child(11) {
    width: 250px;
    height: 250px;
    background: radial-gradient(circle, rgba(102,126,234,0.2) 0%, transparent 70%);
    bottom: -10%;
    right: 5%;
    animation-delay: -5s;
    filter: blur(50px);
}

.gradient-orb:nth-child(12) {
    width: 180px;
    height: 180px;
    background: radial-gradient(circle, rgba(255,215,0,0.25) 0%, transparent 70%);
    top: 15%;
    right: -5%;
    animation-delay: -2s;
    filter: blur(45px);
}

.gradient-orb:nth-child(13) {
    width: 220px;
    height: 220px;
    background: radial-gradient(circle, rgba(102,126,234,0.3) 0%, transparent 70%);
    bottom: 15%;
    right: -8%;
    animation-delay: -4s;
    filter: blur(55px);
}

/* Keyframe animations */
@keyframes float {
    0%, 100% { transform: translateY(0px) rotate(0deg); }
    50% { transform: translateY(-20px) rotate(180deg); }
}

@keyframes pulse {
    0%, 100% { transform: scale(1); opacity: 0.6; }
    50% { transform: scale(1.2); opacity: 0.4; }
}

@keyframes rotate {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

@keyframes slide {
    0%, 100% { transform: translateX(-100px); opacity: 0; }
    50% { transform: translateX(0px); opacity: 1; }
}

/* Responsive Design */
@media (max-width: 992px) {
    .hero-content-wrapper {
        grid-template-columns: 1fr;
        gap: 2rem;
        text-align: center;
    }

    .hero-text-content {
        padding-right: 0;
        transform: translateX(0);
    }

    .hero-abstract-effects {
        display: none;
    }

    .hero-area h2 {
        font-size: 2.5rem;
    }
}

@media (max-width: 768px) {
    .hero-area h2 {
        font-size: 2rem;
    }
    
    .hero-area h6 {
        font-size: 1rem;
        padding: 0 1rem;
    }

    .hero-area {
        min-height: 40vh !important;
    }
}
</style>

    <!-- ##### Hero Area End ##### -->




<!-- ##### Flagship Funds Section Start ##### -->
   <!-- ##### Flagship Funds Section Start ##### -->
    <section class="cryptos-feature-area section-padding-100-0" style="background: linear-gradient(180deg, #0a0a0a 0%, #1a1a2e 100%); position: relative; padding-bottom: 120px;">
        <div id="particles-funds"></div>
        <div class="container-fluid" style="position: relative; z-index: 10;">
            <div class="row">
                <div class="col-12">
                    <div class="section-heading text-center mx-auto" style="margin-bottom: 5rem;">
                        <h3 style="font-size: 3rem; color: white; margin-bottom: 2rem;">
                            Our Flagship <span style="background: var(--primary-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Index Funds</span>
                        </h3>
                        <p style="font-size: 1.1rem; color: rgba(255,255,255,0.7); max-width: 600px; margin: 0 auto; line-height: 1.8;">
                            Professional crypto investment solutions designed for different risk profiles and investment objectives.
                        </p>
                    </div>
                </div>
            </div>
            
            <div class="row">
                <% if (error) { %>
                    <div class="col-12">
                        <div class="alert alert-warning text-center" style="background: rgba(255, 193, 7, 0.1); border: 1px solid rgba(255, 193, 7, 0.3); color: #ffc107; border-radius: 10px; padding: 2rem; margin-bottom: 3rem;">
                            <%= error %>
                        </div>
                    </div>
                <% } else if (funds && funds.length > 0) { %>
                    <% funds.forEach(function(fund, index) { %>
                        <div class="col-12 col-md-6 col-xl-3">
                            <div class="fund-card mb-60">
                                <div class="fund-icon-wrapper">
                                    <div class="fund-icon 
                                        <%= fund.name.includes('Growth') ? 'growth-icon' : '' %>
                                        <%= fund.name.includes('Balanced') ? 'balanced-icon' : '' %>
                                        <%= fund.name.includes('Pioneer') ? 'pioneer-icon' : '' %>
                                        <%= fund.name.includes('AmanRC') ? 'amanrc-icon' : '' %>">
                                        <i class="
                                            <%= fund.name.includes('Growth') ? 'fas fa-chart-line' : '' %>
                                            <%= fund.name.includes('Balanced') ? 'fas fa-balance-scale' : '' %>
                                            <%= fund.name.includes('Pioneer') ? 'fas fa-rocket' : '' %>
                                            <%= fund.name.includes('AmanRC') ? 'fas fa-crown' : '' %>
                                        "></i>
                                    </div>
                                </div>
                                
                                <div class="fund-content">
                                    <div class="fund-header">
                                        <h4 class="fund-name"><%= fund.name %></h4>
                                        <p class="fund-tagline"><%= fund.summary %></p>
                                    </div>
                                    
                                    <div class="fund-stats">
                                        <div class="stat-row">
                                            <span class="stat-label">Current NAV:</span>
                                            <span class="stat-value">$<%= fund.currentNAVFromDB.toFixed(4) %></span>
                                        </div>
                                        <div class="stat-row">
                                            <span class="stat-label">Inception NAV:</span>
                                            <span class="stat-value">$<%= fund.inceptionNAV.toFixed(2) %></span>
                                        </div>
                                        <div class="stat-row">
                                            <span class="stat-label">Total Return:</span>
                                            <span class="stat-value <%= fund.totalReturnFromDB >= 0 ? 'positive' : 'negative' %>">
                                                <%= fund.totalReturnFromDB >= 0 ? '+' : '' %><%= fund.totalReturnFromDB.toFixed(2) %>%
                                            </span>
                                        </div>
                                        <div class="stat-row">
                                            <span class="stat-label">Composition:</span>
                                            <span class="stat-value composition-text">
                                                <% fund.composition.slice(0, 2).forEach(function(coin, i) { %>
                                                    <%= coin.symbol %> <%= (coin.weight * 100).toFixed(0) %>%<%= i < 1 && fund.composition.length > 2 ? ', ' : '' %>
                                                <% }); %>
                                                <% if (fund.composition.length > 2) { %> +<%= fund.composition.length - 2 %> more<% } %>
                                            </span>
                                        </div>
                                    </div>
                                    
                                    <button class="view-details-btn" onclick="openFundModal('<%= fund.symbol %>')">
                                        View Details
                                    </button>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div class="col-12">
                        <div class="alert alert-info text-center" style="background: rgba(102, 126, 234, 0.1); border: 1px solid rgba(102, 126, 234, 0.3); color: #667eea; border-radius: 10px; padding: 2rem; margin-bottom: 3rem;">
                            No funds are currently available.
                        </div>
                    </div>
                <% } %>
            </div>
            
            <!-- Call to Action -->
            <div class="row">
                <div class="col-12 text-center" style="margin-top: 4rem;">
                    <a href="/funds" class="explore-funds-btn">
                        Explore All Our Funds
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Fund Modal -->
    <div id="fundModal" class="fund-modal">
        <div class="modal-backdrop"></div>
        <div class="modal-content">
            <div class="modal-header">
                <h3 id="modalFundName"></h3>
                <button class="modal-close" onclick="closeFundModal()">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="modal-fund-overview">
                    <div class="overview-section">
                        <h5>Fund Summary</h5>
                        <p id="modalFundSummary"></p>
                    </div>
                    <div class="overview-section">
                        <h5>Description</h5>
                        <p id="modalFundDescription"></p>
                    </div>
                </div>
                
                <div class="modal-stats-grid">
                    <div class="modal-stat-item">
                        <span class="modal-stat-label">Current NAV</span>
                        <span class="modal-stat-value" id="modalCurrentNAV"></span>
                    </div>
                    <div class="modal-stat-item">
                        <span class="modal-stat-label">Inception NAV</span>
                        <span class="modal-stat-value" id="modalInceptionNAV"></span>
                    </div>
                    <div class="modal-stat-item">
                        <span class="modal-stat-label">Total Return</span>
                        <span class="modal-stat-value" id="modalTotalReturn"></span>
                    </div>
                    <div class="modal-stat-item">
                        <span class="modal-stat-label">Risk Level</span>
                        <span class="modal-stat-value" id="modalRiskLevel"></span>
                    </div>
                </div>
                
                <div class="modal-composition">
                    <h5>Complete Fund Composition</h5>
                    <div id="modalCompositionGrid" class="composition-grid"></div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="#" id="modalFundLink" class="modal-fund-btn">Go to Fund Page</a>
            </div>
        </div>
    </div>
    <!-- ##### Flagship Funds Section End ##### -->

