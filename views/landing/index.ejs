    /* .hero-area .col-md-6:first-child {
        text-align: center !important;
    } */
    
    .hero-area .col-md-6:first-child div[style*="display: flex"] {
        justify-content: center !important;
        margin-top: -30px !important;
    }

    
    /* MOBILE RESPONSIVE FOR HERO IMAGES - MOVED 100PX UP */
    .hero-image-stack {
        height: 300px !important; /* Reduced height for mobile */
        display: flex;
