 <style>
        /* Modern Futuristic Styles */
        :root {
            --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            --accent-gradient: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            --dark-gradient: linear-gradient(135deg, #120A8F 0%, #0A0654 50%, #1E1A5C 100%);
            --glow-color: #f8d733;
            --text-glow: 0 0 20px rgba(238, 212, 61, 0.875);
            --gold-color: #FFD700;
        }
        
        /* FAQ Section Styling */
        .faq-section {
            background: linear-gradient(135deg, #0a0a0a 0%, #1a1a2e 100%);
            min-height: 100vh;
            padding: 100px 0;
            position: relative;
        }
        
        /* Particle.js container */
        #particles-faq {
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            z-index: 1;
        }
        
        /* FAQ Container */
        .faq-container {
            position: relative;
            z-index: 10;
            max-width: 900px;
            margin: 0 auto;
        }
        
        /* FAQ Item */
        .faq-item {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 15px;
            margin-bottom: 1.5rem;
            overflow: hidden;
            transition: all 0.3s ease;
        }
        
        .faq-item:hover {
            border-color: rgba(255, 215, 0, 0.3);
            box-shadow: 0 5px 20px rgba(255, 215, 0, 0.1);
        }
        
        /* FAQ Question */
        .faq-question {
            padding: 1.5rem 2rem;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.3s ease;
            border: none;
            background: transparent;
            width: 100%;
            text-align: left;
        }
        
        .faq-question:hover {
            background: rgba(255, 255, 255, 0.05);
        }
        
        .faq-question h4 {
            color: white;
            margin: 0;
            font-size: 1.1rem;
            font-weight: 600;
        }
        
        .faq-toggle {
            color: var(--glow-color);
            font-size: 1.5rem;
            transition: transform 0.3s ease;
        }
        
        .faq-item.active .faq-toggle {
            transform: rotate(45deg);
        }
        
        /* FAQ Answer */
        .faq-answer {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease;
        }
        
        .faq-answer-content {
            padding: 1.5rem 2rem 1.5rem 2rem;
            color: rgba(255, 255, 255, 0.8);
            line-height: 1.7;
        }
        
        .faq-item.active .faq-answer {
            max-height: 200px;
        }
        
        /* Modern buttons */
        .modern-btn {
            background: var(--primary-gradient);
            border: none;
            border-radius: 50px;
            padding: 12px 30px;
            color: white;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
        }
        
        .modern-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(102, 126, 234, 0.4);
            color: white;
            text-decoration: none;
        }
        
        /* Contact form styling */
        .contact-form {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            padding: 2.5rem;
        }
        
        .contact-form .form-control {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 10px;
            padding: 15px 20px;
            color: white;
            margin-bottom: 1.5rem;
        }
        
        .contact-form .form-control::placeholder {
            color: rgba(255, 255, 255, 0.6);
        }
        
        .contact-form .form-control:focus {
            background: rgba(255, 255, 255, 0.15);
            border-color: var(--glow-color);
            box-shadow: 0 0 0 0.2rem rgba(255, 215, 0, 0.25);
            outline: none;
        }
        
        /* Social links */
        .social-links {
            display: flex;
            gap: 1rem;
            justify-content: center;
            margin-top: 2rem;
        }
        
        .social-links a {
            width: 50px;
            height: 50px;
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            transition: all 0.3s ease;
            text-decoration: none;
        }
        
        .social-links a:hover {
            background: var(--glow-color);
            color: #000;
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(255, 215, 0, 0.3);
            text-decoration: none;
        }
        
        /* Responsive Design */
        @media (max-width: 768px) {
    .faq-section {
        padding: 50px 0;
    }
    
    .faq-question {
        padding: 1.25rem 1.5rem;
    }
    
    .faq-question h4 {
        font-size: 1rem;
    }
    
    .faq-answer-content {
        padding: 1.25rem 1.5rem 1.25rem 1.5rem;
    }
    
    .contact-form {
        padding: 1.5rem;
    }
}
    </style>

    <!-- ##### FAQ Section Start ##### -->
    <section class="faq-section">
        <div id="particles-faq"></div>
        <div class="container">
            <!-- Page Title -->
            <div class="row">
                <div class="col-12">
                    <div class="section-heading text-center mx-auto" style="margin-bottom: 4rem;">
                        <h2 style="font-size: 3rem; color: white; margin-bottom: 1.5rem;">
                            Frequently Asked <span style="background: var(--primary-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Questions</span>
                        </h2>
                        <p style="font-size: 1.1rem; color: rgba(255,255,255,0.7); max-width: 600px; margin: 0 auto; line-height: 1.8;">
                            Find answers to common questions about CDT Index and cryptocurrency investing.
                        </p>
                    </div>
                </div>
            </div>

            <!-- FAQ Items -->
            <div class="row">
                <div class="col-12">
                    <div class="faq-container">
                        <!-- FAQ Item 1 -->
                        <div class="faq-item">
                            <button class="faq-question" type="button">
                                <h4>What is a crypto index fund?</h4>
                                <span class="faq-toggle">+</span>
                            </button>
                            <div class="faq-answer">
                                <div class="faq-answer-content">
                                    A crypto index fund is a diversified investment vehicle that tracks the performance of multiple cryptocurrencies. CDT Index pools the top 5 performing cryptocurrencies into a single portfolio, allowing investors to gain exposure to the crypto market without having to buy and manage individual coins.
                                </div>
                            </div>
                        </div>

                        <!-- FAQ Item 2 -->
                        <div class="faq-item">
                            <button class="faq-question" type="button">
                                <h4>How does CDT Index work?</h4>
                                <span class="faq-toggle">+</span>
                            </button>
                            <div class="faq-answer">
                                <div class="faq-answer-content">
                                    CDT Index automatically allocates your investment across the top 5 performing cryptocurrencies. Our professional team continuously monitors and rebalances the portfolio to optimize performance. You receive daily NAV updates and can track your investment's real-time value through our platform.
                                </div>
                            </div>
                        </div>

                        <!-- FAQ Item 3 -->
                        <div class="faq-item">
                            <button class="faq-question" type="button">
                                <h4>Is investing in CDT Index safe?</h4>
                                <span class="faq-toggle">+</span>
                            </button>
                            <div class="faq-answer">
                                <div class="faq-answer-content">
                                    CDT Index employs institutional-grade security measures including multi-signature wallets, cold storage, and professional risk management. While cryptocurrency investments carry inherent risks, our diversified approach and professional management help mitigate individual coin volatility.
                                </div>
                            </div>
                        </div>

                        <!-- FAQ Item 4 -->
                        <div class="faq-item">
                            <button class="faq-question" type="button">
                                <h4>What is the minimum investment amount?</h4>
                                <span class="faq-toggle">+</span>
                            </button>
                            <div class="faq-answer">
                                <div class="faq-answer-content">
                                    CDT Index is designed to be accessible to all investors. Our minimum investment amount is $100, making professional cryptocurrency portfolio management available to both new and experienced investors looking to diversify their digital asset exposure.
                                </div>
                            </div>
                        </div>

                        <!-- FAQ Item 5 -->
                        <div class="faq-item">
                            <button class="faq-question" type="button">
                                <h4>How are fees structured?</h4>
                                <span class="faq-toggle">+</span>
                            </button>
                            <div class="faq-answer">
                                <div class="faq-answer-content">
                                    CDT Index maintains a transparent fee structure with competitive management fees. There are no hidden costs or surprise charges. Our fees are calculated as a percentage of assets under management and are clearly disclosed before you invest.
                                </div>
                            </div>
                        </div>

                        <!-- FAQ Item 6 -->
                        <div class="faq-item">
                            <button class="faq-question" type="button">
                                <h4>Can I withdraw my investment anytime?</h4>
                                <span class="faq-toggle">+</span>
                            </button>
                            <div class="faq-answer">
                                <div class="faq-answer-content">
                                    Yes, CDT Index offers flexible withdrawal options. You can redeem your investment at any time based on the current NAV. Withdrawal requests are typically processed within 1-3 business days, subject to market conditions and liquidity requirements.
                                </div>
                            </div>
                        </div>

                        <!-- FAQ Item 7 -->
                        <div class="faq-item">
                            <button class="faq-question" type="button">
                                <h4>Have more questions?</h4>
                                <span class="faq-toggle">+</span>
                            </button>
                            <div class="faq-answer">
                                <div class="faq-answer-content">
                                    Send us a message from the section below!
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- ##### FAQ Section End ##### -->

    

    <!-- ##### All Javascript Script ##### -->
    <!-- jQuery-2.2.4 js -->
    <script src="/js/jquery/jquery-2.2.4.min.js"></script>
    <!-- Popper js -->
    <script src="/js/bootstrap/popper.min.js"></script>
    <!-- Bootstrap js -->
    <script src="/js/bootstrap/bootstrap.min.js"></script>
    <!-- All Plugins js -->
    <script src="/js/plugins/plugins.js"></script>
    <!-- Particles.js -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/particles.js/2.0.0/particles.min.js"></script>
    <!-- Active js -->
    <script src="/js/active.js"></script>
    
    <script>
        // Particles.js configuration
        const particleConfig = {
            "particles": {
                "number": {
                    "value": 60,
                    "density": {
                        "enable": true,
                        "value_area": 800
                    }
                },
                "color": {
                    "value": ["#FFFFFF", "#FFD700"]
                },
                "shape": {
                    "type": "circle"
                },
                "opacity": {
                    "value": 0.3,
                    "random": true,
                    "anim": {
                        "enable": true,
                        "speed": 0.4,
                        "opacity_min": 0.1,
                        "sync": false
                    }
                },
                "size": {
                    "value": 2,
                    "random": true
                },
                "line_linked": {
                    "enable": true,
                    "distance": 150,
                    "color": "#FFFFFF",
                    "opacity": 0.15,
                    "width": 1
                },
                "move": {
                    "enable": true,
                    "speed": 2,
                    "direction": "none",
                    "random": true,
                    "straight": false,
                    "out_mode": "out",
                    "bounce": false
                }
            },
            "interactivity": {
                "detect_on": "canvas",
                "events": {
                    "onhover": {
                        "enable": false
                    },
                    "onclick": {
                        "enable": false
                    },
                    "resize": true
                }
            },
            "retina_detect": true
        };

        // Initialize particles
        document.addEventListener('DOMContentLoaded', function() {
            if (window.particlesJS) {
                particlesJS('particles-faq', particleConfig);
            }
        });

        // FAQ Toggle Functionality
        document.querySelectorAll('.faq-question').forEach(question => {
            question.addEventListener('click', function() {
                const faqItem = this.closest('.faq-item');
                const isActive = faqItem.classList.contains('active');
                
                // Close all FAQ items
                document.querySelectorAll('.faq-item').forEach(item => {
                    item.classList.remove('active');
                });
                
                // Open clicked item if it wasn't active
                if (!isActive) {
                    faqItem.classList.add('active');
                }
            });
        });

        // Contact Form Submission
        document.getElementById('contactForm').addEventListener('submit', function(e) {
            e.preventDefault();
            alert('Thank you for your message! We will get back to you within 24 hours.');
            this.reset();
        });

        // Smooth loading animation
        window.addEventListener('load', function() {
            const faqItems = document.querySelectorAll('.faq-item');
            faqItems.forEach((item, index) => {
                item.style.opacity = '0';
                item.style.transform = 'translateY(20px)';
                setTimeout(() => {
                    item.style.transition = 'all 0.5s ease';
                    item.style.opacity = '1';
                    item.style.transform = 'translateY(0)';
                }, index * 100);
            });
        });
    </script>
