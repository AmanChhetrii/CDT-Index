<!-- ##### Call to Action Section ##### -->
<section class="cta-section">
    <div class="cta-container">
        <div class="cta-content-wrapper">
            <div class="cta-text-content">
                <h2>Ready to Invest?</h2>
                <p>Join thousands of investors who trust CDT Index for professional cryptocurrency portfolio management.</p>
                <div class="cta-buttons">
                    <a href="/signup" class="btn modern-btn cta-btn-primary">
                        Get Started
                    </a>
                    <a href="/services" class="btn modern-btn cta-btn-secondary">
                        Learn More
                    </a>
                </div>
            </div>
            
            <div class="cta-abstract-effects">
                <div class="floating-shape"></div>
                <div class="floating-shape"></div>
                <div class="floating-shape"></div>
                <div class="gradient-orb"></div>
                <div class="gradient-orb"></div>
                <div class="hex-pattern"></div>
                <div class="hex-pattern"></div>
                <div class="animated-line"></div>
                <div class="animated-line"></div>
                <div class="gradient-orb"></div>
                <div class="gradient-orb"></div>
                <div class="gradient-orb"></div>
                <div class="gradient-orb"></div>
            </div>
        </div>
    </div>
</section>
<!-- ##### Call to Action Section End ##### -->

<script>
// Call to Action section specific JavaScript
(function() {
    // Enhanced button interactions
    function enhanceButtonInteractions() {
        const ctaButtons = document.querySelectorAll('.cta-section .modern-btn');
        
        ctaButtons.forEach(button => {
            // Add click ripple effect
            button.addEventListener('click', function(e) {
                const ripple = document.createElement('span');
                const rect = this.getBoundingClientRect();
                const size = Math.max(rect.width, rect.height);
                const x = e.clientX - rect.left - size / 2;
                const y = e.clientY - rect.top - size / 2;
                
                ripple.style.cssText = `
                    position: absolute;
                    width: ${size}px;
                    height: ${size}px;
                    left: ${x}px;
                    top: ${y}px;
                    background: rgba(255, 255, 255, 0.3);
                    border-radius: 50%;
                    transform: scale(0);
                    animation: ripple-effect 0.6s ease-out;
                    pointer-events: none;
                `;
                
                this.appendChild(ripple);
                
                setTimeout(() => {
                    ripple.remove();
                }, 600);
            });
            
            // Add hover glow effect (only on devices that support hover)
            if (window.matchMedia('(hover: hover)').matches) {
                button.addEventListener('mouseenter', function() {
                    if (this.classList.contains('cta-btn-primary')) {
                        this.style.boxShadow = '0 15px 35px rgba(102, 126, 234, 0.6)';
                    } else {
                        this.style.boxShadow = '0 15px 35px rgba(255, 255, 255, 0.3)';
                    }
                });
                
                button.addEventListener('mouseleave', function() {
                    this.style.boxShadow = '';
                });
            }
        });
    }
    
    // Responsive adjustments based on screen size
    function handleResponsiveAdjustments() {
        const ctaSection = document.querySelector('.cta-section');
        const screenWidth = window.innerWidth;
        
        // Add screen size class for additional styling hooks
        ctaSection.classList.remove('mobile', 'tablet', 'desktop');
        
        if (screenWidth <= 767) {
            ctaSection.classList.add('mobile');
        } else if (screenWidth <= 991) {
            ctaSection.classList.add('tablet');
        } else {
            ctaSection.classList.add('desktop');
        }
    }
    
    // Initialize all interactions and responsive handling
    function init() {
        enhanceButtonInteractions();
        handleResponsiveAdjustments();
    }
    
    // Initialize when DOM is ready
    document.addEventListener('DOMContentLoaded', init);
    
    // Handle window resize
    window.addEventListener('resize', function() {
        handleResponsiveAdjustments();
    });
    
    // Handle orientation change on mobile devices
    window.addEventListener('orientationchange', function() {
        setTimeout(handleResponsiveAdjustments, 100);
    });
})();
</script>