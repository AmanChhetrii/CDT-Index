    }
    
    .cta-content-wrapper {
        grid-template-columns: 1fr;
        gap: 2rem;
        text-align: center;
        min-height: 250px;
    }

    .cta-text-content {
        padding-right: 0;
    }

    .cta-abstract-effects {
        display: none;
    }

