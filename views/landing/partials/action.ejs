    }
    
    .cta-section p {
        font-size: 1.1rem;
        margin-bottom: 2.5rem;
        max-width: 100%;
    }
    
    .cta-buttons {
        justify-content: center;
        gap: 1.2rem;
    }
    
    .cta-btn-primary,
    .cta-btn-secondary {
        padding: 14px 35px;
        font-size: 1rem;
        min-width: 160px;
    }
}

/* Large Mobile Devices (576px to 767px) */
@media (min-width: 576px) and (max-width: 767px) {
    .cta-section {
        padding: 60px 0;
        min-height: 350px;
    }
    
    .cta-container {
