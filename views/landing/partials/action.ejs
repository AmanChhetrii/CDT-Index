<style>
/* Call to Action Section Styles */
:root {
    --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

/* Modern buttons - simplified hover effects */
.modern-btn {
    background: var(--primary-gradient);
    border: none;
    border-radius: 50px;
    padding: 12px 30px;
    color: white;
    font-weight: 600;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
    text-decoration: none;
    display: inline-block;
    cursor: pointer;
}

.modern-btn:hover {
    transform: translateY(-3px);
    color: white;
    text-decoration: none;
    box-shadow: 0 10px 25px rgba(102, 126, 234, 0.4);
}

/* CTA specific button styles */
.cta-btn-primary {
    background: white;
    color: #667eea;
    border-radius: 50px;
    padding: 15px 40px;
    font-weight: 600;
    transition: all 0.3s ease;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
}

.cta-btn-primary:hover {
    transform: translateY(-3px);
    color: #667eea;
    text-decoration: none;
    box-shadow: 0 15px 35px rgba(102, 126, 234, 0.3);
}

.cta-btn-secondary {
    background: transparent;
    border: 2px solid white;
    color: white;
    border-radius: 50px;
    padding: 13px 38px; /* Adjusted for border */
    font-weight: 600;
    transition: all 0.3s ease;
}

.cta-btn-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    transform: translateY(-3px);
    color: white;
    text-decoration: none;
    box-shadow: 0 15px 35px rgba(255, 255, 255, 0.2);
}

/* Button container styles */
.cta-buttons {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-items: center;
}

/* Main CTA Section Layout */
.cta-section {
    background: var(--primary-gradient);
    padding: 80px 0;
    position: relative;
    overflow: hidden;
    min-height: 500px;
}

.cta-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
    z-index: 2;
}

.cta-content-wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 4rem;
    min-height: 400px;
}

.cta-text-content {
    padding-right: 2rem;
}

.cta-section h2 {
    color: white;
    font-size: 4rem;
    margin-bottom: 1.5rem;
    font-weight: 700;
    line-height: 1.1;
}

.cta-section p {
    color: rgba(255,255,255,0.9);
    font-size: 1.2rem;
    margin-bottom: 3rem;
    line-height: 1.6;
    max-width: 90%;
}

/* Abstract Effects Container */
.cta-abstract-effects {
    position: relative;
    height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
}

/* Floating geometric shapes */
.floating-shape {
    position: absolute;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    animation: float 6s ease-in-out infinite;
}

.floating-shape:nth-child(1) {
    width: 120px;
    height: 120px;
    top: 10%;
    right: 20%;
    animation-delay: 0s;
}

.floating-shape:nth-child(2) {
    width: 80px;
    height: 80px;
    top: 60%;
    right: 10%;
    animation-delay: -2s;
}

.floating-shape:nth-child(3) {
    width: 60px;
    height: 60px;
    top: 30%;
    right: 50%;
    animation-delay: -4s;
}

/* Gradient orbs */
.gradient-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(40px);
    opacity: 0.6;
    animation: pulse 8s ease-in-out infinite;
}

.gradient-orb:nth-child(4) {
    width: 200px;
    height: 200px;
    background: radial-gradient(circle, rgba(255,255,255,0.3) 0%, transparent 70%);
    top: 5%;
    right: 15%;
    animation-delay: 0s;
}

.gradient-orb:nth-child(5) {
    width: 150px;
    height: 150px;
    background: radial-gradient(circle, rgba(118,75,162,0.4) 0%, transparent 70%);
    bottom: 10%;
    right: 30%;
    animation-delay: -3s;
}

/* Hexagonal patterns */
.hex-pattern {
    position: absolute;
    width: 40px;
    height: 40px;
    background: rgba(255, 255, 255, 0.05);
    clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
    animation: rotate 20s linear infinite;
}

.hex-pattern:nth-child(6) {
    top: 20%;
    right: 40%;
    animation-delay: 0s;
}

.hex-pattern:nth-child(7) {
    bottom: 20%;
    right: 60%;
    animation-delay: -10s;
}

/* Animated lines */
.animated-line {
    position: absolute;
    height: 2px;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
    animation: slide 4s ease-in-out infinite;
}

.animated-line:nth-child(8) {
    width: 150px;
    top: 40%;
    right: 25%;
    animation-delay: 0s;
}

.animated-line:nth-child(9) {
    width: 100px;
    bottom: 30%;
    right: 45%;
    animation-delay: -2s;
}

/* Additional gradient orbs */
.gradient-orb:nth-child(10) {
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
    top: -5%;
    right: 35%;
    animation-delay: -1s;
    filter: blur(60px);
}

.gradient-orb:nth-child(11) {
    width: 250px;
    height: 250px;
    background: radial-gradient(circle, rgba(102,126,234,0.2) 0%, transparent 70%);
    bottom: -10%;
    right: 5%;
    animation-delay: -5s;
    filter: blur(50px);
}

/* New abstract circles on extreme right */
.gradient-orb:nth-child(12) {
    width: 180px;
    height: 180px;
    background: radial-gradient(circle, rgba(255,255,255,0.25) 0%, transparent 70%);
    top: 15%;
    right: -5%;
    animation-delay: -2s;
    filter: blur(45px);
}

.gradient-orb:nth-child(13) {
    width: 220px;
    height: 220px;
    background: radial-gradient(circle, rgba(118,75,162,0.3) 0%, transparent 70%);
    bottom: 15%;
    right: -8%;
    animation-delay: -4s;
    filter: blur(55px);
}

/* Keyframe animations */
@keyframes float {
    0%, 100% { transform: translateY(0px) rotate(0deg); }
    50% { transform: translateY(-20px) rotate(180deg); }
}

@keyframes pulse {
    0%, 100% { transform: scale(1); opacity: 0.6; }
    50% { transform: scale(1.2); opacity: 0.4; }
}

@keyframes rotate {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

@keyframes slide {
    0%, 100% { transform: translateX(-100px); opacity: 0; }
    50% { transform: translateX(0px); opacity: 1; }
}

@keyframes ripple-effect {
    to {
        transform: scale(2);
        opacity: 0;
    }
}

/* Comprehensive Responsive Design */

/* Large Desktops (1400px and up) */
@media (min-width: 1400px) {
    .cta-container {
        max-width: 1400px;
        padding: 0 40px;
    }
    
    .cta-section h2 {
        font-size: 4.5rem;
    }
    
    .cta-section p {
        font-size: 1.3rem;
    }
    
    .cta-buttons {
        gap: 2rem;
    }
}

/* Standard Desktops (1200px to 1399px) */
@media (min-width: 1200px) and (max-width: 1399px) {
    .cta-container {
        max-width: 1200px;
    }
    
    .cta-section h2 {
        font-size: 4rem;
    }
}

/* Large Tablets and Small Desktops (992px to 1199px) */
@media (min-width: 992px) and (max-width: 1199px) {
    .cta-container {
        max-width: 960px;
        padding: 0 30px;
    }
    
    .cta-content-wrapper {
        gap: 3rem;
    }
    
    .cta-section h2 {
        font-size: 3.5rem;
    }
    
    .cta-section p {
        font-size: 1.1rem;
    }
    
    .cta-text-content {
        padding-right: 1rem;
    }
    
    /* Reduce abstract effects size */
    .cta-abstract-effects {
        height: 350px;
    }
    
    .floating-shape:nth-child(1) {
        width: 100px;
        height: 100px;
    }
    
    .floating-shape:nth-child(2) {
        width: 70px;
        height: 70px;
    }
    
    .gradient-orb:nth-child(4) {
        width: 180px;
        height: 180px;
    }
    
    .gradient-orb:nth-child(10) {
        width: 250px;
        height: 250px;
    }
}

/* Tablets (768px to 991px) */
@media (min-width: 768px) and (max-width: 991px) {
    .cta-section {
        padding: 70px 0;
        min-height: 400px;
    }
    
    .cta-container {
        max-width: 720px;
        padding: 0 25px;
    }
    
    .cta-content-wrapper {
        grid-template-columns: 1fr;
        gap: 2.5rem;
        text-align: center;
        min-height: 300px;
    }

    .cta-text-content {
        padding-right: 0;
        max-width: 100%;
    }

