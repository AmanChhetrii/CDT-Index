<!-- CSS Styles -->
<style>
    /* Reset and override existing styles with maximum specificity */
    .header-area, .header-area *, .cdt-main-nav, .cdt-main-nav *, .cdt-logo, .cdt-logo * {
        box-sizing: border-box !important;
        margin: 0 !important;
        padding: 0 !important;
    }

    /* Header Styles - Clean implementation with maximum specificity */
    .header-area {
        position: fixed !important;
        top: 0 !important;
        left: 0 !important;
        width: 100% !important;
        z-index: 1000 !important;
        /* Navy dark blue to royal purple with crimson shade (only 10% purple) */
        background: linear-gradient(135deg, #0a0e34 0%, #260e44 50%, #32002c 100%) !important;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1) !important;
    }

    .cdt-container {
        max-width: 1200px !important;
        margin: 0 auto !important;
        padding: 0 !important;
        width: 100% !important;
    }

    /* Main Navigation - Static navbar with increased height */
    .cdt-main-nav {
        background: rgba(0,0,0,0.3) !important;
        padding: 0 !important;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1) !important;
        height: 80px !important; /* Increased by 10px */
        width: 100% !important;
    }

    .cdt-nav-content {
        display: flex !important;
        justify-content: space-between !important;
        align-items: center !important;
        height: 100% !important;
        width: 100% !important;
        padding: 0 !important;
        margin: 0 !important;
    }

    /* Logo positioned towards right from extreme left */
    .cdt-logo {
        position: absolute !important;
        left: 0 !important;
        top: 50% !important;
        transform: translateY(-50%) !important;
        margin-left: 100px !important; 
        padding-left: 0 !important;
        margin-right: 0 !important;
        padding-right: 0 !important;
        z-index: 1001 !important;
    }

    .cdt-logo img {
        width: 190px !important; /* Increased by 10px */
        height: auto !important;
        display: block !important;
        margin: 0 !important;
        padding: 0 !important;
    }

    /* Desktop Navigation Menu - Moved further to the right */
    .cdt-nav-menu {
        display: flex !important;
        list-style: none !important;
        margin: 0 !important;
        padding: 0 !important;
        align-items: center !important;
        gap: 20px !important; /* REDUCED from 25px - controls spacing between menu items */
        margin-left: auto !important;
        padding-right: 40px !important; /* Increased from 15px */
        position: relative !important;
        z-index: 1002 !important;
    }

    .cdt-nav-menu a {
        color: rgba(255,255,255,0.9) !important;
        text-decoration: none !important;
        transition: color 0.3s ease !important;
        font-size: 14px !important; /* REDUCED from 15px - makes menu items smaller */
        font-weight: 500 !important;
        transform: none !important;
        white-space: nowrap !important;
    }

    .cdt-nav-menu a:hover {
        color: #DAA520 !important; /* Darker golden yellow instead of lemon */
        transform: none !important;
    }

    /* Investor Login Button - Sharp corners and ONLY border color change */
    .cdt-login-btn {
        color: white !important;
        background: transparent !important;
        border: 1.5px solid white !important;
        padding: 6px 12px !important; /* REDUCED from 8px 16px - makes button smaller */
        border-radius: 0px !important;
        font-size: 12px !important; /* REDUCED from 13px - makes button text smaller */
        font-weight: 500 !important;
        transition: border-color 0.3s ease !important;
        text-decoration: none !important;
        margin-left: 12px !important; /* REDUCED from 15px - less spacing from other menu items */
        white-space: nowrap !important;
    }

    .cdt-login-btn:hover {
        background: transparent !important;
        border-color: #DAA520 !important; /* Only border changes */
        color: white !important; /* Text remains white */
        transform: none !important;
        box-shadow: none !important;
    }

    /* Mobile Toggle Button - No effects, no color changes, no focus styles */
    .cdt-mobile-toggle {
        display: none !important;
        background: transparent !important;
        border: none !important;
        color: white !important;
        font-size: 35px !important;
        cursor: pointer !important;
        padding: 8px 12px !important;
        margin-left: auto !important;
        margin-right: 25px !important;
        min-width: 44px !important;
        text-align: center !important;
        z-index: 1003 !important;
        outline: none !important;
        -webkit-tap-highlight-color: transparent !important;
        -webkit-focus-ring-color: transparent !important;
        -webkit-appearance: none !important;
        -moz-appearance: none !important;
        appearance: none !important;
    }

    .cdt-mobile-toggle:focus,
    .cdt-mobile-toggle:active,
    .cdt-mobile-toggle:visited,
    .cdt-mobile-toggle:hover {
        outline: none !important;
        border: none !important;
        box-shadow: none !important;
        -webkit-tap-highlight-color: transparent !important;
        -webkit-focus-ring-color: transparent !important;
        color: white !important; /* Force white color always */
        background: transparent !important;
    }

    /* Mobile Menu Modal */
    .cdt-mobile-menu {
        position: fixed !important;
        top: 80px !important; /* Updated for new navbar height */
        left: 0 !important;
        width: 100% !important;
        background: linear-gradient(135deg, #0a0e34 0%, #1c0a32 50%, #290124 100%) !important;
        backdrop-filter: blur(10px) !important;
        transform: translateY(-100%) !important;
        opacity: 0 !important;
        visibility: hidden !important;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1) !important;
        z-index: 999 !important;
        box-shadow: 0 4px 20px rgba(0,0,0,0.3) !important;
    }

    .cdt-mobile-menu.active {
        transform: translateY(0) !important;
        opacity: 1 !important;
        visibility: visible !important;
    }

    .cdt-mobile-menu-content {
        padding: 10px 15px !important;
        display: flex !important;
        flex-direction: column !important;
        gap: 15px !important;
    }

    .cdt-mobile-menu a {
        color: rgba(255,255,255,0.9) !important;
        text-decoration: none !important;
        font-size: 16px !important;
        font-weight: 500 !important;
        padding: 12px 0 !important;
        border-bottom: 1px solid rgba(255,255,255,0.1) !important;
    }

    .cdt-mobile-menu a:last-child {
        border-bottom: none !important;
    }

    /* Body margin to prevent content overlap */
    body {
        margin-top: 80px !important; /* Updated for new navbar height */
        transition: margin-top 0.4s ease !important;
    }

    /* Tablet Responsive */
    @media (max-width: 991px) and (min-width: 769px) {
        .cdt-logo {
            margin-left: 30px !important; /* Adjusted for tablet */
        }
        
        .cdt-logo img {
            width: 170px !important; /* Increased proportionally */
        }
        
        .cdt-nav-menu {
            gap: 18px !important; /* REDUCED from 20px */
            padding-right: 30px !important; /* Moved further right */
        }
        
        .cdt-nav-menu a {
            font-size: 13px !important; /* REDUCED from 14px */
        }
        
        .cdt-login-btn {
            padding: 5px 10px !important; /* REDUCED from 6px 12px */
            font-size: 11px !important; /* REDUCED from 12px */
        }
    }

    /* Mobile Responsive - NO HOVER EFFECTS */
    @media (max-width: 768px) {
        .cdt-logo {
            margin-left: 25px !important; /* Moved right on mobile */
        }
        
        .cdt-logo img {
            width: 150px !important; /* Increased by 10px */
        }

        .cdt-nav-menu {
            display: none !important;
        }

        .cdt-mobile-toggle {
            display: block !important;
            margin-right: 20px !important;
        }

        .cdt-main-nav {
            height: 70px !important; /* Increased by 10px */
        }

        .cdt-mobile-menu {
            top: 70px !important;
        }

        body {
            margin-top: 70px !important;
        }
        
        /* Ensure no color change on mobile toggle */
        .cdt-mobile-toggle:hover,
        .cdt-mobile-toggle:active,
        .cdt-mobile-toggle:focus {
            color: white !important; /* Keep white always */
        }
    }

    /* Small Mobile */
    @media (max-width: 480px) {
        .cdt-container {
            padding: 0 !important;
        }
        
        .cdt-logo {
            margin-left: 20px !important; /* Moved right on small mobile */
        }
        
        .cdt-logo img {
            width: 130px !important; /* Increased by 10px */
        }
        
        .cdt-main-nav {
            height: 65px !important; /* Increased by 10px */
        }

        .cdt-mobile-menu {
            top: 65px !important;
        }
        
        body {
            margin-top: 65px !important;
        }

        .cdt-mobile-toggle {
            margin-right: 15px !important;
        }
    }

    /* Large Desktop */
    @media (min-width: 1400px) {
        .cdt-container {
            max-width: 1320px !important;
        }
        
        .cdt-logo {
            margin-left: 100px !important; /* Moved further right on large screens */
        }
        
        .cdt-logo img {
            width: 210px !important; /* Increased by 10px */
        }
        
        .cdt-nav-menu {
            gap: 25px !important; /* REDUCED from 30px */
            padding-right: 50px !important; /* Moved further right */
        }
        
        .cdt-nav-menu a {
            font-size: 15px !important; /* REDUCED from 16px */
        } 
        
        .cdt-login-btn {
            padding: 8px 14px !important; /* REDUCED from 10px 18px */
            font-size: 13px !important; /* REDUCED from 14px */
        }
    }

    /* Force hide mobile menu on desktop */
    @media (min-width: 769px) {
        .cdt-mobile-menu {
            display: none !important;
        }
        
        .cdt-mobile-toggle {
            display: none !important;
        }
    }

    /* Additional overrides to ensure logo positioning */
    header .cdt-logo,
    .header-area .cdt-logo,
    #header .cdt-logo {
        position: absolute !important;
        left: 0 !important;
        margin-left: 40px !important;
        transform: translateY(-50%) !important;
        top: 50% !important;
    }

    /* Force navigation to the right with absolute positioning */
    header .cdt-nav-menu,
    .header-area .cdt-nav-menu,
    #header .cdt-nav-menu {
        position: absolute !important;
        right: 0 !important;
        top: 50% !important;
        transform: translateY(-50%) !important;
        margin-right: 25px !important;
        margin-left: 0 !important;
        padding-right: 0 !important;
    }
</style>

<!-- Header Area Start -->
<header class="header-area" id="header">
    <!-- Navbar Area -->
    <div class="cdt-main-nav">
        <div class="cdt-container">
            <div class="cdt-nav-content">
                <!-- Logo -->
                <a class="cdt-logo" href="/">
                    <img src="/img/core-img/logolight.png" alt="Logo">
                </a>
                
                <!-- Desktop Navigation Menu -->
                <nav class="cdt-nav-menu">
                    <a href="/">HOME</a>
                    <a href="/funds">FUNDS</a>
                    <a href="/services">SERVICES</a>
                    <a href="/about-us">ABOUT US</a>
                    <a href="/login" class="cdt-login-btn">INVESTOR LOGIN</a>
                </nav>

                <!-- Mobile Toggle Button -->
                <button class="cdt-mobile-toggle" id="mobileToggle">
                    <span>&#9776;</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Mobile Menu Modal -->
    <div class="cdt-mobile-menu" id="mobileMenu">
        <div class="cdt-mobile-menu-content">
            <a href="/">HOME</a>
            <a href="/funds">FUNDS</a>
            <a href="/services">SERVICES</a>
            <a href="/about-us">ABOUT US</a>
            <a href="/login">INVESTOR LOGIN</a>
        </div>
    </div>
</header>

<!-- JavaScript for Mobile Menu -->
<script>
    const mobileToggle = document.getElementById('mobileToggle');
    const mobileMenu = document.getElementById('mobileMenu');
    
    // Mobile menu toggle functionality - ONLY toggles menu, no other effects
    mobileToggle.addEventListener('click', function() {
        mobileMenu.classList.toggle('active');
    });
    
    // Smooth scroll behavior for navigation links
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
            e.preventDefault();
            const target = document.querySelector(this.getAttribute('href'));
            if (target) {
                target.scrollIntoView({
                    behavior: 'smooth',
                    block: 'start'
                });
            }
        });
    });
</script>