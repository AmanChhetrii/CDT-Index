<style>
/* Contact Section Styles */
:root {
    --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    --accent-gradient: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
    --glow-color: #f8d733;
}

/* Particle.js container */
#particles-contact {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    z-index: 1;
}

/* Contact form styling */
.contact-form {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    padding: 2.5rem;
}

.contact-form .form-control {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 10px;
    padding: 15px 20px;
    color: white;
    margin-bottom: 1.5rem;
}

.contact-form .form-control::placeholder {
    color: rgba(255, 255, 255, 0.6);
}

.contact-form .form-control:focus {
    background: rgba(255, 255, 255, 0.15);
    border-color: var(--glow-color);
    box-shadow: 0 0 0 0.2rem rgba(255, 215, 0, 0.25);
    color: white;
    outline: none;
}

/* Modern buttons */
.modern-btn {
    background: var(--primary-gradient);
    border: none;
    border-radius: 50px;
    padding: 12px 30px;
    color: white;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
}

.modern-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(102, 126, 234, 0.4);
    color: white;
    text-decoration: none;
}

/* Social links */
.social-links {
    display: flex;
    gap: 1rem;
    justify-content: center;
    margin-top: 2rem;
}

.social-links a {
    width: 50px;
    height: 50px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    transition: all 0.3s ease;
    text-decoration: none;
}

.social-links a:hover {
    background: var(--glow-color);
    color: #000;
    transform: translateY(-3px);
    box-shadow: 0 5px 15px rgba(255, 215, 0, 0.3);
    text-decoration: none;
}

/* Contact info styling */
.single-contact-info {
    margin-bottom: 1.5rem;
}

.contact-icon {
    margin-right: 15px;
    color: var(--glow-color);
    width: 20px;
    text-align: center;
}

/* Responsive Design */
@media (max-width: 768px) {
    .contact-form {
        padding: 1.5rem;
    }
    
    .section-heading h3 {
        font-size: 2rem !important;
    }
    
    /* Center only the logo and social links, keep text left-aligned */
    .contact-logo {
        text-align: center;
        margin-left: 0 !important;
        margin-top: 0 !important;
    }
    
    .contact-logo img {
        margin-left: 0 !important;
        margin-top: 0 !important;
    }
    
    /* Keep paragraph text left-aligned for readability */
    .contact-information p {
        text-align: left;
        margin-left: 12px;
    }
    
    .social-links {
        margin-left: 0 !important;
        justify-content: center;
    }
}
</style>

<!-- ##### Contact Section Start ##### -->
<section class="contact-area section-padding-100-0" style="background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%); position: relative; padding: 100px 0;">
    <div id="particles-contact"></div>
    <div class="container" style="position: relative; z-index: 10;">
        <div class="row">
            <div class="col-12">
                <div class="section-heading text-center mx-auto" style="margin-bottom: 5rem;">
                    <h3 style="font-size: 3rem; color: white; margin-bottom: 2rem;">
                        Get in Touch <span style="background: var(--primary-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">With Us</span>
                    </h3>
                    <p style="font-size: 1.1rem; color: rgba(255,255,255,0.7); max-width: 700px; margin: 0 auto; line-height: 1.8;">
                        Fill out the form below or reach us via our social media handles for quick support.
                    </p>
                </div>
            </div>
        </div>
        
        <div class="row">
            <!-- Contact Information -->
            <div class="col-12 col-lg-6">
                <div class="contact-information mb-100">
                    <!-- Contact Logo -->
                    <div class="contact-logo mb-50">
                        <a href="/"><img src="/img/core-img/logo_darknobg.png" alt="CDT Index" style=" filter: drop-shadow(0 0 10px rgba(255, 215, 0, 0.3)); margin-left: -30px; margin-top: -25px;"></a>
                    </div>

                    <p style="color: rgba(255, 255, 255, 0.8); line-height: 1.8; margin-bottom: 3rem; font-size: 1.1rem; margin-top: -30px;">
    We are always happy to hear from you.<br>
    Whether you have questions about your account or need help with transactions, our team is ready to assist.<br>
    If you want more information about our funds and services, we are here to provide clarity.<br>
    You can reach us by email for general queries.<br>
    For urgent matters, connect with us by phone during business hours.<br>
    We aim to respond to all inquiries within 24 to 48 hours on working days.<br>
    For quick answers, check our FAQ section where common questions are already covered.<br>
</p>


                    <!-- Contact Social Info -->
                    <div class="social-links" style="margin-left: -100px;">
                        <a href="https://www.linkedin.com/in/aman-chhetri-406943256/" title="LinkedIn"><i class="fa fa-linkedin" aria-hidden="true"></i></a>
                        <a href="https://x.com/amanchhetrii" title="Twitter"><i class="fa fa-twitter" aria-hidden="true"></i></a>
                        <a href="https://www.instagram.com/amanchhetriii/" title="instagram"><i class="fa fa-instagram" aria-hidden="true"></i></a>
                        <a href="https://medium.com/@amanchhetri" title="medium"><i class="fa fa-medium" aria-hidden="true"></i></a>
                    </div>
                </div>
            </div>

            <!-- Contact Form Area -->
            <div class="col-12 col-lg-6">
                <div class="contact-form mb-100">
                    <h4 style="color: white; margin-bottom: 1.5rem; text-align: center;">Send us a Message</h4>
                    <p style="color: rgba(255,255,255,0.7); text-align: center; margin-bottom: 3rem;">
                        Send us a message and we'll get back to you within 48 hours.
                    </p>
                    <form id="contactForm" action="#" method="post">
                        <input type="text" class="form-control" id="name" name="name" placeholder="Your Name" required>
                        <input type="email" class="form-control" id="email" name="email" placeholder="Your Email" required>
                        <input type="text" class="form-control" id="subject" name="subject" placeholder="Subject" required>
                        <textarea name="message" class="form-control" id="message" cols="30" rows="8" placeholder="Your Message" required></textarea>
                        <div class="text-center">
                            <button class="btn modern-btn mt-30" type="submit">Send Message</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- ##### Contact Section End ##### -->

<script>
// Contact section specific JavaScript
(function() {
    // Particles.js configuration for contact section
    const particleConfig = {
   "particles": {
       "number": {
           "value": 120,
           "density": {
               "enable": true,
               "value_area": 1000
           }
       },
       "color": {
           "value": "#ffffff"
       },
       "shape": {
           "type": "circle"
       },
       "opacity": {
           "value": 0.3,
           "random": true,
           "anim": {
               "enable": true,
               "speed": 0.5,
               "opacity_min": 0.1,
               "sync": false
           }
       },
       "size": {
           "value": 1,
           "random": true,
           "anim": {
               "enable": true,
               "speed": 0.8,
               "size_min": 0.3,
               "sync": false
           }
       },
       "line_linked": {
           "enable": false
       },
       "move": {
           "enable": true,
           "speed": 0.8,
           "direction": "none",
           "random": true,
           "straight": false,
           "out_mode": "out",
           "bounce": false
       }
   },
   "interactivity": {
       "detect_on": "canvas",
       "events": {
           "onhover": {
               "enable": false
           },
           "onclick": {
               "enable": false
           },
           "resize": true
       }
   },
   "retina_detect": true
};

    // Initialize particles when DOM is ready
    document.addEventListener('DOMContentLoaded', function() {
        if (window.particlesJS && document.getElementById('particles-contact')) {
            particlesJS('particles-contact', particleConfig);
        }
    });

    // Form validation and enhancement
    document.addEventListener('DOMContentLoaded', function() {
        const contactForm = document.getElementById('contactForm');
        if (contactForm) {
            contactForm.addEventListener('submit', function(e) {
                e.preventDefault();
                
                const name = document.getElementById('name').value.trim();
                const email = document.getElementById('email').value.trim();
                const subject = document.getElementById('subject').value.trim();
                const message = document.getElementById('message').value.trim();
                
                if (name && email && subject && message) {
                    // Show success message (replace with actual form submission)
                    alert('Thank you for your message! We will get back to you within 24 hours.');
                    this.reset();
                } else {
                    alert('Please fill in all required fields.');
                }
            });
        }
    });
})();
</script>