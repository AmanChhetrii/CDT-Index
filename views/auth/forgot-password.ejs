<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="description" content="CDT Index - Reset Your Password">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    
    <!-- Title -->
    <title>Forgot Password - CDT Index</title>

    <!-- Favicon -->
    <link rel="icon" href="/img/core-img/logo_smallbg.png">

    <!-- Core Stylesheet -->
    <link rel="stylesheet" href="/style.css">
    <!-- Auth Stylesheet -->
    <link rel="stylesheet" href="/auth/auth.css">

</head>

<body>
    <div class="auth-container">
        <div id="particles-auth"></div>
        
        <div class="auth-card forgot-password">
            <!-- Logo -->
            <div class="auth-logo">
                <img src="/img/core-img/logo.png" alt="CDT Index">
            </div>
            
            <!-- Form State -->
            <div class="form-state">
                <!-- Icon -->
                <div class="auth-icon">
                    <i class="fa fa-lock"></i>
                </div>
                
                <!-- Title -->
                <h2 class="auth-title">Forgot Password?</h2>
                <p class="auth-subtitle">
                    Enter your email address and we'll send you a link to reset your password.
                </p>
                
                <!-- Reset Form -->
                <form id="forgotPasswordForm">
                    <div class="form-group">
                        <input type="email" class="form-control" id="email" placeholder="Enter your email address" required>
                        <div class="error-message" id="emailError">Please enter a valid email address</div>
                        <div class="success-message" id="emailSuccess">Email format is valid</div>
                    </div>
                    
                    <button type="submit" class="auth-btn">Send Reset Link</button>
                </form>
                
                <div class="auth-links">
                    <a href="/login" class="back-to-login">Back to Login</a>
                </div>
            </div>
            
            <!-- Success State -->
            <div class="success-state" id="successState">
                <!-- Icon -->
                <div class="auth-icon">
                    <i class="fa fa-check"></i>
                </div>
                
                <!-- Title -->
                <h2 class="auth-title">Check Your Email</h2>
                <p class="auth-subtitle">
                    We've sent a password reset link to<br>
                    <strong id="emailSent" style="color: var(--glow-color);"></strong>
                </p>
                
                <p style="color: rgba(255, 255, 255, 0.7); font-size: 0.9rem; margin-bottom: 2rem;">
                    If you don't see the email, check your spam folder or try again.
                </p>
                
                <button class="auth-btn" id="resendBtn" onclick="resendEmail()">Resend Email</button>
                <div class="resend-timer" id="resendTimer"></div>
                
                <div class="auth-links" style="margin-top: 2rem;">
                    <a href="/login" class="back-to-login">Back to Login</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/particles.js/2.0.0/particles.min.js"></script>
    <script src="/auth/auth.js"></script>
</body>

</html>