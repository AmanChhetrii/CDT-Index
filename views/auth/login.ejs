<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="description" content="CDT Index - Login to Your Account">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    
    <!-- Title -->
    <title>Login - CDT Index</title>

    <!-- Favicon -->
    <link rel="icon" href="/img/core-img/logo_smallbg.png">

    <!-- Core Stylesheet -->
    <link rel="stylesheet" href="/style.css">
    <!-- Auth Stylesheet -->
    <link rel="stylesheet" href="/auth/auth.css">

</head>

<body>
    <div class="auth-container">
        <div id="particles-auth"></div>
        
        <div class="auth-card login">
            <!-- Logo -->
            <div class="auth-logo">
                <img src="/img/core-img/logo.png" alt="CDT Index">
            </div>
            
            <!-- Title -->
            <h2 class="auth-title">Welcome Back</h2>
            <p class="auth-subtitle">Sign in to your CDT Index account</p>

            <!-- Flash Messages -->
            <% if (typeof error !== 'undefined' && error.length > 0) { %>
                <% error.forEach(function(err) { %>
                    <div class="flash-message flash-error"><%= err %></div>
                <% }); %>
            <% } %>

            <% if (typeof success !== 'undefined' && success.length > 0) { %>
                <% success.forEach(function(msg) { %>
                    <div class="flash-message flash-success"><%= msg %></div>
                <% }); %>
            <% } %>
            
            <!-- Login Form -->
            <form id="loginForm" method="POST" action="/login">
                <div class="form-group">
                    <input type="email" class="form-control" name="email" id="email" placeholder="Email Address" required>
                    <div class="error-message" id="emailError">Please enter a valid email address</div>
                </div>
                
                <div class="form-group">
                    <input type="password" class="form-control" name="password" id="password" placeholder="Password" required>
                    <div class="error-message" id="passwordError">Password is required</div>
                </div>
                
                <div class="remember-forgot">
                    <label class="remember-me">
                        <input type="checkbox" id="remember" name="remember"> Remember me
                    </label>
                    <a href="/reset-pass" class="forgot-password">Forgot Password?</a>
                </div>
                
                <button type="submit" class="auth-btn">Sign In</button>
            </form>
            
            <div class="auth-divider">────────</div>
            
            <div class="auth-links">
                <span style="color: rgba(255, 255, 255, 0.7);">Don't have an account? </span>
                <a href="/signup">Create Account</a>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/particles.js/2.0.0/particles.min.js"></script>
    <script src="/auth/auth.js"></script>
</body>

</html>