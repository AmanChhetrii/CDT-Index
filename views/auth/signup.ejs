<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="description" content="CDT Index - Create Your Account">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    
    <!-- Title -->
    <title>Sign Up - CDT Index</title>

    <!-- Favicon -->
    <link rel="icon" href="/img/core-img/logo_smallbg.png">

    <!-- Core Stylesheet -->
    <link rel="stylesheet" href="/style.css">
    <!-- Auth Stylesheet -->
    <link rel="stylesheet" href="/auth/auth.css">

</head>

<body>
    <div class="auth-container">
        <div id="particles-auth"></div>
        
        <div class="auth-card signup">
            <!-- Logo -->
            <div class="auth-logo">
                <img src="/img/core-img/logo.png" alt="CDT Index">
            </div>
            
            <!-- Title -->
            <h2 class="auth-title">Create Account</h2>
            <p class="auth-subtitle">Start your crypto investment journey</p>

            <!-- Flash Messages -->
            <% if (typeof error !== 'undefined' && error.length > 0) { %>
                <% error.forEach(function(err) { %>
                    <div class="flash-message flash-error"><%= err %></div>
                <% }); %>
            <% } %>

            <% if (typeof success !== 'undefined' && success.length > 0) { %>
                <% success.forEach(function(msg) { %>
                    <div class="flash-message flash-success"><%= msg %></div>
                <% }); %>
            <% } %>
            
            <!-- Signup Form -->
            <form id="signupForm" method="POST" action="/signup">
                <div class="form-row">
                    <div class="form-group">
                        <input type="text" class="form-control" name="firstName" id="firstName" placeholder="First Name" required>
                        <div class="error-message" id="firstNameError">First name is required</div>
                    </div>
                    <div class="form-group">
                        <input type="text" class="form-control" name="lastName" id="lastName" placeholder="Last Name" required>
                        <div class="error-message" id="lastNameError">Last name is required</div>
                    </div>
                </div>
                
                <div class="form-group">
                    <input type="email" class="form-control" name="email" id="email" placeholder="Email Address" required>
                    <div class="error-message" id="emailError">Please enter a valid email address</div>
                </div>
                
                <div class="form-group">
                    <input type="password" class="form-control" name="password" id="password" placeholder="Create Password" required>
                    <div class="password-strength">
                        <div class="strength-bar">
                            <div class="strength-fill" id="strengthFill"></div>
                        </div>
                        <span id="strengthText" style="color: rgba(255, 255, 255, 0.6);">Password strength</span>
                    </div>
                    <div class="error-message" id="passwordError">Password must be at least 8 characters</div>
                </div>
                
                <div class="form-group">
                    <input type="password" class="form-control" name="confirmPassword" id="confirmPassword" placeholder="Confirm Password" required>
                    <div class="error-message" id="confirmPasswordError">Passwords do not match</div>
                </div>
                
                <div class="terms-checkbox">
                    <input type="checkbox" id="terms" name="terms" required>
                    <label for="terms">
                        I agree to the <a href="/terms">Terms of Service</a> and <a href="/privacy">Privacy Policy</a>
                    </label>
                </div>
                
                <button type="submit" class="auth-btn">Create Account</button>
            </form>
            
            <div class="auth-divider">────────</div>
            
            <div class="auth-links">
                <span style="color: rgba(255, 255, 255, 0.7);">Already have an account? </span>
                <a href="/login">Sign In</a>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/particles.js/2.0.0/particles.min.js"></script>
    <script src="/auth/auth.js"></script>
</body>

</html>